<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>flowscout — Test Report — {{ start_url }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/@lgtm-hq/turbo-themes@0.19.2/packages/css/dist/turbo-core.css">
    <link rel="stylesheet" href="https://unpkg.com/@lgtm-hq/turbo-themes@0.19.2/packages/css/dist/turbo-base.css">
    <link id="turbo-theme-stylesheet" rel="stylesheet" href="https://unpkg.com/@lgtm-hq/turbo-themes@0.19.2/packages/css/dist/themes/catppuccin-mocha.css">
    <script>
        (function() {
            const storageKey = 'flowscout-report-theme';
            const fallbackTheme = 'catppuccin-mocha';
            try {
                const saved = window.localStorage.getItem(storageKey);
                document.documentElement.setAttribute('data-theme', saved || fallbackTheme);
            } catch (_err) {
                document.documentElement.setAttribute('data-theme', fallbackTheme);
            }
        })();
    </script>
    <style>
        :root {
            --bg-deep: var(--turbo-bg-base, #06080c);
            --bg-base: var(--turbo-bg-base, #0a0f18);
            --bg-surface: var(--turbo-bg-surface, #0f1620);
            --bg-raised: var(--turbo-bg-overlay, #141e2b);
            --bg-overlay: color-mix(in srgb, var(--turbo-bg-overlay, #1a2636) 78%, var(--turbo-bg-base, #0a0f18));
            --border-dim: color-mix(in srgb, var(--turbo-border-default, #1c2940) 58%, transparent);
            --border-base: var(--turbo-border-default, #243352);
            --border-bright: color-mix(in srgb, var(--turbo-border-default, #2d4a73) 78%, white);
            --text-primary: var(--turbo-text-primary, #c8d6e5);
            --text-secondary: var(--turbo-text-secondary, #7a8fa6);
            --text-muted: color-mix(in srgb, var(--turbo-text-secondary, #4a5f78) 68%, transparent);
            --accent-green: var(--turbo-state-success, #00e59b);
            --accent-green-dim: color-mix(in srgb, var(--turbo-state-success, #00e59b) 28%, transparent);
            --accent-green-glow: color-mix(in srgb, var(--turbo-state-success, #00e59b) 16%, transparent);
            --accent-amber: var(--turbo-state-warning, #ffbe0b);
            --accent-amber-dim: color-mix(in srgb, var(--turbo-state-warning, #ffbe0b) 24%, transparent);
            --accent-red: var(--turbo-state-danger, #ff4757);
            --accent-red-dim: color-mix(in srgb, var(--turbo-state-danger, #ff4757) 24%, transparent);
            --accent-blue: var(--turbo-brand-primary, #4facfe);
            --accent-blue-dim: color-mix(in srgb, var(--turbo-brand-primary, #4facfe) 24%, transparent);
            --accent-cyan: var(--turbo-state-info, #00f5d4);
            --accent-cyan-dim: color-mix(in srgb, var(--turbo-state-info, #00f5d4) 24%, transparent);
            --accent-purple: color-mix(in srgb, var(--turbo-brand-primary, #a78bfa) 52%, var(--turbo-state-danger, #a78bfa));
            --accent-purple-dim: color-mix(in srgb, var(--accent-purple) 18%, transparent);
            --modal-overlay: color-mix(in srgb, var(--bg-deep) 82%, transparent);
            --modal-shell-start: color-mix(in srgb, var(--bg-surface) 82%, var(--bg-base));
            --modal-shell-end: color-mix(in srgb, var(--bg-base) 92%, var(--bg-deep));
            --modal-aura-primary: color-mix(in srgb, var(--accent-cyan) 12%, transparent);
            --modal-aura-secondary: color-mix(in srgb, var(--accent-blue) 12%, transparent);
            --modal-border: color-mix(in srgb, var(--accent-cyan) 20%, var(--border-base));
            --modal-shadow: color-mix(in srgb, var(--bg-deep) 68%, transparent);
            --modal-header-start: color-mix(in srgb, var(--bg-raised) 72%, var(--bg-surface));
            --modal-header-end: color-mix(in srgb, var(--bg-base) 88%, transparent);
            --modal-close-bg: color-mix(in srgb, var(--bg-raised) 82%, var(--bg-base));
            --modal-card-start: color-mix(in srgb, var(--bg-surface) 84%, var(--bg-base));
            --modal-card-end: color-mix(in srgb, var(--bg-base) 92%, var(--bg-deep));
            --modal-focus-start: color-mix(in srgb, var(--bg-raised) 82%, var(--bg-base));
            --modal-focus-end: color-mix(in srgb, var(--bg-base) 92%, var(--bg-deep));
            --modal-text-start: color-mix(in srgb, var(--bg-surface) 84%, var(--bg-base));
            --modal-text-end: color-mix(in srgb, var(--bg-base) 94%, var(--bg-deep));
            --modal-card-step-accent: color-mix(in srgb, var(--accent-purple) 78%, white 4%);
            --modal-card-action-accent: color-mix(in srgb, var(--accent-cyan) 76%, white 4%);
            --modal-card-outcome-accent: color-mix(in srgb, var(--accent-green) 74%, white 3%);
            --modal-card-verdict-accent: color-mix(in srgb, var(--accent-amber) 74%, white 3%);
            --modal-card-confidence-accent: color-mix(in srgb, var(--accent-blue) 74%, white 3%);
            --modal-card-input-accent: color-mix(in srgb, var(--accent-purple) 68%, var(--accent-cyan) 12%);
            --font-mono: 'JetBrains Mono', 'SF Mono', 'Cascadia Code', monospace;
            --font-body: 'DM Sans', 'SF Pro Display', -apple-system, sans-serif;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: var(--font-body);
            background: var(--bg-deep);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* === Atmospheric background === */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 50% at 20% 0%, color-mix(in srgb, var(--accent-green) 8%, transparent) 0%, transparent 60%),
                radial-gradient(ellipse 60% 40% at 80% 100%, color-mix(in srgb, var(--accent-blue) 7%, transparent) 0%, transparent 60%),
                radial-gradient(ellipse 100% 100% at 50% 50%, var(--bg-base) 0%, var(--bg-deep) 100%);
            pointer-events: none;
            z-index: -1;
        }

        /* === Scanline texture === */
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                #00000008 2px,
                #00000008 4px
            );
            pointer-events: none;
            z-index: 1000;
            mix-blend-mode: multiply;
        }

        /* === Typography === */
        .font-mono { font-family: var(--font-mono); }

        /* === Layout === */
        .report-container { max-width: 1440px; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 3rem); }

        /* === Header === */
        .report-header {
            position: sticky;
            top: 0;
            z-index: 50;
            border-bottom: 1px solid var(--border-dim);
            background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-deep)ee 100%);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
        }

        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 0;
            gap: 2rem;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .brand-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--accent-green) 0%, var(--accent-cyan) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 20px var(--accent-green-dim), inset 0 1px 0 #ffffff20;
        }

        .brand-icon svg { width: 18px; height: 18px; }

        .brand-text {
            font-family: var(--font-mono);
            font-weight: 600;
            font-size: 1.125rem;
            letter-spacing: -0.02em;
            background: linear-gradient(135deg, var(--accent-green) 0%, var(--accent-cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .brand-subtitle {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-muted);
            margin-left: 0.75rem;
            padding: 0.1875rem 0.5rem;
            border: 1px solid var(--border-dim);
            border-radius: 4px;
        }

        .header-meta {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .header-meta-item {
            display: flex;
            align-items: center;
            gap: 0.375rem;
        }

        .theme-picker {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.28rem 0.42rem;
            border: 1px solid var(--border-dim);
            border-radius: 8px;
            background: color-mix(in srgb, var(--bg-surface) 70%, transparent);
        }

        .theme-picker-label {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            white-space: nowrap;
        }

        .theme-picker-select {
            appearance: none;
            border: 1px solid var(--border-dim);
            border-radius: 6px;
            background: var(--bg-base);
            color: var(--text-primary);
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            line-height: 1.2;
            padding: 0.25rem 1.45rem 0.25rem 0.45rem;
            min-width: 164px;
            outline: none;
            background-image:
                linear-gradient(45deg, transparent 50%, var(--text-muted) 50%),
                linear-gradient(135deg, var(--text-muted) 50%, transparent 50%);
            background-position:
                calc(100% - 0.82rem) calc(50% - 0.08rem),
                calc(100% - 0.56rem) calc(50% - 0.08rem);
            background-size: 0.32rem 0.32rem, 0.32rem 0.32rem;
            background-repeat: no-repeat;
        }

        .theme-picker-select:hover {
            border-color: var(--border-bright);
        }

        .theme-picker-select:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-blue) 28%, transparent);
        }

        .header-meta-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent-green);
            box-shadow: 0 0 8px var(--accent-green-dim);
            animation: pulse-dot 2s ease-in-out infinite;
        }

        @keyframes pulse-dot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        /* === Target URL banner === */
        .target-banner {
            margin-top: 2rem;
            padding: 1.25rem 1.5rem;
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 1rem;
            position: relative;
            overflow: hidden;
        }

        .target-banner::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(180deg, var(--accent-green) 0%, var(--accent-cyan) 100%);
            border-radius: 3px 0 0 3px;
        }

        .target-label {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--accent-green);
            opacity: 0.7;
        }

        .target-url {
            font-family: var(--font-mono);
            font-size: 0.9375rem;
            font-weight: 400;
            color: var(--text-primary);
            letter-spacing: -0.01em;
        }

        /* ============================================================
           DASHBOARD
           ============================================================ */
        .dashboard {
            margin-top: 2rem;
            display: grid;
            grid-template-columns: 200px 1fr;
            gap: 1.5rem;
            align-items: start;
        }

        /* --- Pass rate donut --- */
        .pass-rate-ring {
            position: relative;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            justify-self: center;
        }

        .pass-rate-ring-inner {
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: var(--bg-deep);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1;
        }

        .pass-rate-pct {
            font-family: var(--font-mono);
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.04em;
            color: var(--accent-green);
            line-height: 1;
        }

        .pass-rate-label {
            font-family: var(--font-mono);
            font-size: 0.5625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        /* --- Dashboard right panel --- */
        .dashboard-right {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        /* --- Metric cards row --- */
        .metric-cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1px;
            background: var(--border-dim);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-dim);
        }

        .metric-card {
            background: var(--bg-surface);
            padding: 1rem 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            transition: background 0.2s ease;
        }

        .metric-card:hover { background: var(--bg-raised); }

        .metric-value {
            font-family: var(--font-mono);
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1;
            color: var(--text-primary);
        }

        .metric-value.green { color: var(--accent-green); }
        .metric-value.amber { color: var(--accent-amber); }
        .metric-value.red { color: var(--accent-red); }
        .metric-value.blue { color: var(--accent-blue); }
        .metric-value.cyan { color: var(--accent-cyan); }

        .metric-label {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
        }

        .metric-breakdown {
            display: flex;
            gap: 0.375rem;
            margin-top: 0.375rem;
        }

        .metric-breakdown-bar {
            height: 3px;
            border-radius: 2px;
            transition: width 0.6s ease;
        }

        .quick-actions {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .page-nav {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            flex-wrap: wrap;
            margin: 1rem 0 1.25rem;
        }

        .page-btn {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--text-muted);
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            padding: 0.35rem 0.75rem;
            border-radius: 7px;
            cursor: pointer;
            transition: all 0.18s ease;
        }

        .page-btn:hover {
            border-color: var(--border-base);
            color: var(--text-secondary);
        }

        .page-btn.active {
            color: var(--accent-cyan);
            border-color: var(--accent-cyan-dim);
            background: rgba(103, 232, 249, 0.08);
        }

        [data-report-page].page-hidden {
            display: none !important;
        }

        /* --- Coverage bars --- */
        .coverage-bars {
            display: flex;
            flex-direction: column;
            gap: 0.625rem;
            padding: 1rem 1.25rem;
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
        }

        .coverage-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .coverage-label {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            width: 140px;
            flex-shrink: 0;
        }

        .coverage-track {
            flex: 1;
            height: 6px;
            background: var(--bg-overlay);
            border-radius: 3px;
            overflow: hidden;
        }

        .coverage-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.6s ease;
        }

        .coverage-fill.green { background: var(--accent-green); }
        .coverage-fill.blue { background: var(--accent-blue); }
        .coverage-fill.cyan { background: var(--accent-cyan); }

        .coverage-pct {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 600;
            color: var(--text-secondary);
            width: 60px;
            text-align: right;
            flex-shrink: 0;
        }

        /* ============================================================
           SECTIONS
           ============================================================ */
        .section {
            margin-top: 3rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }

        .section-header h2 {
            font-family: var(--font-body);
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text-primary);
            letter-spacing: -0.01em;
        }

        .section-count {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 500;
            color: var(--text-muted);
            background: var(--bg-raised);
            border: 1px solid var(--border-dim);
            padding: 0.125rem 0.5rem;
            border-radius: 100px;
        }

        .section-line {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, var(--border-dim) 0%, transparent 100%);
        }

        /* --- Collapsible sections --- */
        .section-collapsible .section-header {
            cursor: pointer;
            user-select: none;
            padding: 0.5rem 0;
            border-radius: 8px;
            transition: opacity 0.15s ease;
        }

        .section-collapsible .section-header:hover { opacity: 0.85; }

        .section-toggle-icon {
            width: 16px;
            height: 16px;
            color: var(--text-muted);
            transition: transform 0.25s ease;
            flex-shrink: 0;
        }

        .section-collapsible.collapsed .section-toggle-icon { transform: rotate(-90deg); }
        .section-collapsible.collapsed .section-body { display: none; }

        /* ============================================================
           TEST SUITES (primary view)
           ============================================================ */

        /* --- Filter toolbar --- */
        .filter-toolbar {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter-btn {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 500;
            color: var(--text-muted);
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            padding: 0.375rem 0.75rem;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .filter-btn:hover { border-color: var(--border-base); color: var(--text-secondary); }
        .filter-btn.active { color: var(--accent-green); border-color: var(--accent-green); background: var(--accent-green-dim); }
        .filter-btn.active-fail { color: var(--accent-red); border-color: var(--accent-red); background: var(--accent-red-dim); }
        .filter-btn.active-warn { color: var(--accent-amber); border-color: var(--accent-amber); background: var(--accent-amber-dim); }

        .search-box {
            margin-left: auto;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-primary);
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            padding: 0.375rem 0.75rem;
            border-radius: 6px;
            outline: none;
            width: 220px;
            transition: border-color 0.15s ease;
        }

        .search-box::placeholder { color: var(--text-muted); }
        .search-box:focus { border-color: var(--accent-cyan-dim); }

        /* --- Test suite (group) --- */
        .test-suite { margin-bottom: 1rem; }

        .suite-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            cursor: pointer;
            margin-bottom: 0.5rem;
            transition: background 0.15s ease;
        }

        .suite-header:hover { background: var(--bg-raised); }

        .suite-chevron {
            width: 14px; height: 14px;
            color: var(--text-muted);
            transition: transform 0.2s ease;
            flex-shrink: 0;
        }

        .test-suite.collapsed .suite-chevron { transform: rotate(-90deg); }
        .test-suite.collapsed .suite-body { display: none; }

        .suite-name {
            font-weight: 600;
            font-size: 0.875rem;
        }

        .suite-meta {
            display: flex;
            gap: 0.5rem;
            margin-left: auto;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            align-items: center;
        }

        .suite-stat {
            padding: 0.125rem 0.5rem;
            border-radius: 4px;
            font-weight: 600;
        }

        .suite-stat.pass { color: var(--accent-green); background: var(--accent-green-dim); }
        .suite-stat.fail { color: var(--accent-red); background: var(--accent-red-dim); }
        .suite-stat.warn { color: var(--accent-amber); background: var(--accent-amber-dim); }

        .suite-pass-bar {
            width: 60px;
            height: 4px;
            background: var(--bg-overlay);
            border-radius: 2px;
            overflow: hidden;
        }

        .suite-pass-fill {
            height: 100%;
            background: var(--accent-green);
            border-radius: 2px;
            transition: width 0.4s ease;
        }

        .suite-body {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        /* --- Test case card --- */
        .test-case {
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            overflow: hidden;
            transition: border-color 0.2s ease;
        }

        .test-case:hover { border-color: var(--border-base); }

        .test-case-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.875rem 1.25rem;
            cursor: pointer;
            user-select: none;
            transition: background 0.15s ease;
            list-style: none;
        }

        .test-case-header::-webkit-details-marker { display: none; }
        .test-case-header::marker { display: none; content: ''; }
        .test-case-header:hover { background: var(--bg-raised); }

        .test-case-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 0;
        }

        .test-case-right {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-shrink: 0;
        }

        .tc-chevron {
            width: 16px;
            height: 16px;
            color: var(--text-muted);
            transition: transform 0.2s ease;
            flex-shrink: 0;
        }

        details[open] .tc-chevron { transform: rotate(180deg); }

        .tc-name {
            font-weight: 500;
            font-size: 0.875rem;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tc-steps-count {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-muted);
            white-space: nowrap;
        }

        /* --- Verdict badge --- */
        .verdict {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 0.1875rem 0.5rem;
            border-radius: 4px;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .verdict.pass {
            color: var(--accent-green);
            background: var(--accent-green-dim);
        }
        .verdict.fail {
            color: var(--accent-red);
            background: var(--accent-red-dim);
        }
        .verdict.warn {
            color: var(--accent-amber);
            background: var(--accent-amber-dim);
        }
        .verdict.inconclusive {
            color: var(--text-muted);
            background: #4a5f7815;
        }

        /* --- Flow type badge --- */
        .type-badge {
            font-family: var(--font-mono);
            font-size: 0.5625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 0.1875rem 0.5rem;
            border-radius: 4px;
            flex-shrink: 0;
        }

        .type-badge.linear {
            color: var(--accent-blue);
            background: var(--accent-blue-dim);
        }

        .type-badge.cycle {
            color: var(--accent-amber);
            background: var(--accent-amber-dim);
        }

        /* --- Tags --- */
        .tc-tags { display: flex; gap: 0.25rem; flex-shrink: 0; }
        .tc-tag {
            font-family: var(--font-mono);
            font-size: 0.5625rem;
            font-weight: 500;
            padding: 0.125rem 0.375rem;
            border-radius: 3px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .tc-tag.navigation { color: var(--accent-green); background: var(--accent-green-dim); }
        .tc-tag.search { color: var(--accent-cyan); background: var(--accent-cyan-dim); }
        .tc-tag.form { color: var(--accent-amber); background: var(--accent-amber-dim); }
        .tc-tag.dropdown { color: var(--accent-purple); background: var(--accent-purple-dim); }
        .tc-tag.interaction { color: var(--text-muted); background: #4a5f7815; }

        /* --- Test case body --- */
        .test-case-body {
            padding: 0 1.25rem 1.25rem;
            border-top: 1px solid var(--border-dim);
        }

        /* --- Precondition --- */
        .precondition {
            margin-top: 1rem;
            padding: 0.625rem 1rem;
            background: var(--bg-raised);
            border-left: 3px solid var(--accent-purple);
            border-radius: 0 6px 6px 0;
            font-size: 0.8125rem;
            color: var(--accent-purple);
            font-style: italic;
        }

        /* --- Step timeline --- */
        .step-timeline {
            margin-top: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .step-item {
            display: grid;
            grid-template-columns: 32px 1fr;
            gap: 0 0.75rem;
            padding: 0.75rem 0;
            position: relative;
        }

        .step-item:not(:last-child)::after {
            content: '';
            position: absolute;
            left: 15px;
            top: 44px;
            bottom: 0;
            width: 2px;
            background: var(--border-dim);
        }

        .step-item.pass:not(:last-child)::after { background: var(--accent-green-dim); }
        .step-item.fail:not(:last-child)::after { background: var(--accent-red-dim); }
        .step-item.warn:not(:last-child)::after { background: var(--accent-amber-dim); }

        .step-number {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            border: 2px solid var(--border-base);
            background: var(--bg-surface);
            color: var(--text-muted);
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        .step-item.pass .step-number { border-color: var(--accent-green); color: var(--accent-green); }
        .step-item.fail .step-number { border-color: var(--accent-red); color: var(--accent-red); }
        .step-item.warn .step-number { border-color: var(--accent-amber); color: var(--accent-amber); }

        .step-content { min-width: 0; }

        .step-action-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .step-action-text {
            font-size: 0.8125rem;
            font-weight: 500;
            color: var(--text-primary);
        }

        .step-details {
            margin-top: 0.375rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .step-target {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            max-width: 100%;
            color: var(--text-secondary);
            border: 1px dashed var(--border-dim);
            border-radius: 6px;
            padding: 0.2rem 0.45rem;
            margin-bottom: 0.15rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .step-target-label {
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .step-expected,
        .step-actual {
            font-size: 0.75rem;
            display: flex;
            align-items: baseline;
            gap: 0.4rem;
        }

        .step-tag {
            font-family: var(--font-mono);
            font-size: 0.5625rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            padding: 0.125rem 0.375rem;
            border-radius: 3px;
            flex-shrink: 0;
        }

        .step-tag.expected {
            color: var(--accent-purple);
            background: var(--accent-purple-dim);
            border: 1px solid rgba(167, 139, 250, 0.25);
        }

        .step-tag.actual {
            color: var(--accent-cyan);
            background: rgba(103, 232, 249, 0.10);
            border: 1px solid rgba(103, 232, 249, 0.20);
        }

        .step-expected .step-text { color: rgba(167, 139, 250, 0.7); }
        .step-actual .step-text { color: rgba(103, 232, 249, 0.7); }

        /* --- Conclusion --- */
        .conclusion {
            margin-top: 0.75rem;
            padding: 0.625rem 1rem;
            background: var(--bg-raised);
            border-radius: 6px;
            font-size: 0.8125rem;
            color: var(--text-secondary);
            font-style: italic;
        }

        /* --- BDD toggle --- */
        .gherkin-toggle {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            cursor: pointer;
            color: var(--accent-cyan);
            background: none;
            border: 1px solid var(--accent-cyan-dim);
            padding: 0.25rem 0.625rem;
            border-radius: 4px;
            margin-top: 0.75rem;
        }
        .gherkin-toggle:hover { background: var(--accent-cyan-dim); }
        .gherkin-block {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--accent-cyan);
            background: var(--bg-raised);
            padding: 0.75rem 1rem;
            border-radius: 6px;
            margin-top: 0.5rem;
            white-space: pre-wrap;
            display: none;
            border: 1px solid var(--accent-cyan-dim);
        }
        .gherkin-block.visible { display: block; }

        /* --- State chain (debug) --- */
        .state-chain-toggle {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            cursor: pointer;
            color: var(--text-muted);
            background: none;
            border: 1px solid var(--border-dim);
            padding: 0.1875rem 0.5rem;
            border-radius: 4px;
            margin-top: 0.5rem;
            margin-left: 0.5rem;
        }

        .state-chain-toggle:hover { border-color: var(--border-base); }

        .state-chain {
            display: none;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.375rem;
            margin-top: 0.5rem;
        }

        .state-chain.visible { display: flex; }

        .state-node {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 500;
            padding: 0.25rem 0.625rem;
            background: var(--bg-overlay);
            border: 1px solid var(--border-base);
            border-radius: 6px;
            color: var(--accent-cyan);
        }

        .state-arrow {
            color: var(--text-muted);
            font-size: 0.75rem;
        }

        /* ============================================================
           COVERAGE ANALYSIS
           ============================================================ */
        .coverage-table-wrap {
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
            overflow: hidden;
        }

        .untested-callout {
            margin-top: 1rem;
            padding: 0.875rem 1.25rem;
            background: var(--accent-amber-dim);
            border: 1px solid rgba(255, 190, 11, 0.2);
            border-radius: 8px;
            font-size: 0.8125rem;
            color: var(--accent-amber);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .untested-callout .callout-icon {
            font-size: 1rem;
            flex-shrink: 0;
        }

        /* ============================================================
           DEFECTS
           ============================================================ */
        .defect-card {
            background: linear-gradient(135deg, #ff475708, #ff475703);
            border: 1px solid #ff475725;
            border-radius: 10px;
            padding: 1rem 1.25rem;
            cursor: pointer;
            transition: border-color 0.15s ease;
        }

        .defect-card:hover { border-color: #ff475750; }

        .defect-card.warning {
            background: linear-gradient(135deg, #ffbe0b08, #ffbe0b03);
            border-color: #ffbe0b25;
        }

        .defect-card.warning:hover { border-color: #ffbe0b50; }

        .defect-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.375rem;
        }

        .defect-name {
            font-weight: 500;
            font-size: 0.875rem;
        }

        .defect-detail {
            font-size: 0.8125rem;
            color: var(--text-secondary);
        }

        /* ============================================================
           DIAGNOSTICS
           ============================================================ */
        .diagnostics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .diag-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            padding: 0.875rem 1rem;
        }

        .diag-label {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            margin-bottom: 0.35rem;
        }

        .diag-value {
            font-family: var(--font-mono);
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .diag-value.warn { color: var(--accent-amber); }
        .diag-value.fail { color: var(--accent-red); }
        .diag-value.pass { color: var(--accent-green); }

        .diag-subtext {
            margin-top: 0.35rem;
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .diag-reason-list {
            margin-top: 0.55rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
        }

        .diag-chip {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            color: var(--text-secondary);
            border: 1px solid var(--border-dim);
            border-radius: 999px;
            padding: 0.2rem 0.5rem;
            background: var(--bg-overlay);
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .diagnostic-row {
            cursor: pointer;
        }

        .diagnostic-row:hover {
            background: #0d2230 !important;
        }

        .diag-step-meta {
            margin-top: 0.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .diag-step-meta .meta-line {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-muted);
            max-width: 460px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ============================================================
           TABLES (shared)
           ============================================================ */
        .data-table-wrap {
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
            overflow: hidden;
        }

        .data-table {
            width: 100%;
            font-size: 0.8125rem;
            border-collapse: collapse;
        }

        .data-table thead th {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            text-align: left;
            padding: 0.75rem 1.25rem;
            border-bottom: 1px solid var(--border-dim);
            background: var(--bg-raised);
            position: sticky;
            top: 0;
        }

        .data-table thead th.right { text-align: right; }

        .data-table tbody td {
            padding: 0.625rem 1.25rem;
            border-bottom: 1px solid #0f1620;
            vertical-align: middle;
        }

        .data-table tbody tr { transition: background 0.1s ease; }
        .data-table tbody tr:hover { background: var(--bg-raised); }
        .data-table tbody tr:last-child td { border-bottom: none; }

        .cell-id {
            font-family: var(--font-mono);
            font-weight: 500;
            font-size: 0.75rem;
            color: var(--accent-cyan);
        }

        .cell-url {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-muted);
            max-width: 340px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .cell-dim {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .cell-right {
            text-align: right;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .cell-action {
            font-size: 0.75rem;
            color: var(--text-secondary);
            max-width: 420px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .cell-signals {
            font-size: 0.6875rem;
            color: var(--text-muted);
            max-width: 250px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .table-scroll {
            overflow-x: auto;
            max-height: 480px;
            overflow-y: auto;
        }

        .confidence-cell {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-primary);
        }

        .confidence-reason {
            max-width: 260px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .execution-row-highlight {
            background: #0c2235 !important;
            box-shadow: inset 3px 0 0 var(--accent-cyan);
        }

        .execution-log-row {
            cursor: pointer;
        }

        .execution-log-row:hover {
            background: #102334 !important;
        }

        .input-provenance {
            margin-top: 0.75rem;
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            padding: 0.75rem 0.875rem;
        }

        .input-provenance-title {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            margin-bottom: 0.25rem;
        }

        .input-provenance-meta {
            font-size: 0.75rem;
            color: var(--text-secondary);
        }

        .elements-summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .elements-type-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 0.75rem;
        }

        .elements-subtitle {
            margin: 0.75rem 0 0.5rem;
            font-family: var(--font-body);
            font-size: 0.95rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .elements-subtitle-hint {
            margin: -0.15rem 0 0.55rem;
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .elements-subtitle-small {
            padding: 0.75rem 1rem 0.25rem;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
        }

        .elements-drilldown-row {
            cursor: pointer;
        }

        .elements-drilldown-row:hover {
            background: #102334 !important;
        }

        .elements-modal-group {
            background: linear-gradient(180deg, var(--modal-card-start), var(--modal-card-end));
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            padding: 0.75rem 0.8rem;
        }

        .elements-modal-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        .elements-modal-chip {
            border: 1px solid var(--border-dim);
            border-radius: 999px;
            background: var(--bg-overlay);
            padding: 0.25rem 0.55rem;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-secondary);
        }

        .elements-entry-kind {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 0.15rem 0.45rem;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border: 1px solid var(--border-dim);
            color: var(--text-secondary);
        }

        .elements-entry-kind.interactive {
            color: var(--accent-green);
            border-color: rgba(16, 185, 129, 0.35);
            background: rgba(16, 185, 129, 0.08);
        }

        .elements-entry-kind.content {
            color: var(--accent-amber);
            border-color: rgba(245, 158, 11, 0.35);
            background: rgba(245, 158, 11, 0.08);
        }

        .elements-visibility {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 0.15rem 0.45rem;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border: 1px solid var(--border-dim);
            color: var(--text-secondary);
        }

        .elements-visibility.visible {
            color: var(--accent-cyan);
            border-color: rgba(34, 211, 238, 0.35);
            background: rgba(34, 211, 238, 0.1);
        }

        .elements-visibility.hidden {
            color: #fca5a5;
            border-color: rgba(239, 68, 68, 0.35);
            background: rgba(239, 68, 68, 0.12);
        }

        .page-object-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 0.85rem;
        }

        .pom-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
            padding: 0.9rem 1rem;
        }

        .pom-card-header {
            display: flex;
            justify-content: space-between;
            gap: 0.75rem;
            align-items: flex-start;
            margin-bottom: 0.55rem;
        }

        .pom-class-name {
            font-family: var(--font-mono);
            font-size: 0.78rem;
            color: var(--accent-cyan);
            margin-bottom: 0.15rem;
        }

        .pom-page-name {
            font-size: 0.93rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.3rem;
        }

        .pom-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 0.3rem;
        }

        .pom-badge {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            border-radius: 999px;
            padding: 0.16rem 0.5rem;
            border: 1px solid var(--border-dim);
            color: var(--text-muted);
            background: var(--bg-overlay);
        }

        .pom-quality {
            min-width: 74px;
            text-align: center;
            border-radius: 8px;
            border: 1px solid var(--border-dim);
            padding: 0.35rem 0.45rem;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--text-secondary);
            background: var(--bg-overlay);
        }

        .pom-quality.good {
            color: var(--accent-green);
            border-color: rgba(16, 185, 129, 0.35);
            background: rgba(16, 185, 129, 0.09);
        }

        .pom-quality.warn {
            color: var(--accent-amber);
            border-color: rgba(245, 158, 11, 0.35);
            background: rgba(245, 158, 11, 0.08);
        }

        .pom-quality.bad {
            color: var(--accent-red);
            border-color: rgba(239, 68, 68, 0.35);
            background: rgba(239, 68, 68, 0.1);
        }

        .pom-submeta {
            margin-bottom: 0.65rem;
            font-size: 0.72rem;
            color: var(--text-muted);
            line-height: 1.45;
            word-break: break-word;
        }

        .pom-card-details summary {
            cursor: pointer;
            font-family: var(--font-mono);
            font-size: 0.68rem;
            color: var(--text-secondary);
            margin-bottom: 0.6rem;
        }

        .pom-stability {
            font-family: var(--font-mono);
            font-size: 0.62rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .pom-stability.high { color: var(--accent-green); }
        .pom-stability.medium { color: var(--accent-amber); }
        .pom-stability.low { color: var(--accent-red); }

        .pom-code-tools {
            margin-top: 0.7rem;
            display: flex;
            gap: 0.35rem;
            flex-wrap: wrap;
        }

        .pom-lang-btn {
            font-family: var(--font-mono);
            font-size: 0.64rem;
            border-radius: 6px;
            border: 1px solid var(--border-dim);
            background: var(--bg-overlay);
            color: var(--text-muted);
            padding: 0.2rem 0.45rem;
            cursor: pointer;
        }

        .pom-lang-btn.active {
            color: var(--accent-cyan);
            border-color: var(--accent-cyan-dim);
            background: rgba(34, 211, 238, 0.08);
        }

        .pom-code-block {
            margin: 0.6rem 0 0;
            border: 1px solid var(--border-dim);
            border-radius: 8px;
            background: var(--bg-raised);
            padding: 0.7rem 0.75rem;
            max-height: 340px;
            overflow: auto;
            display: none;
            font-family: var(--font-mono);
            font-size: 0.67rem;
            line-height: 1.45;
            color: var(--text-secondary);
        }

        .pom-code-block.active {
            display: block;
        }

        .execution-modal {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: var(--modal-overlay);
            backdrop-filter: blur(2px);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .execution-modal.visible {
            display: flex;
        }

        .execution-modal-dialog {
            width: min(980px, 95vw);
            max-height: 92vh;
            overflow: auto;
            background:
                radial-gradient(circle at 82% -14%, var(--modal-aura-primary), transparent 42%),
                radial-gradient(circle at -8% 12%, var(--modal-aura-secondary), transparent 45%),
                linear-gradient(180deg, var(--modal-shell-start) 0%, var(--modal-shell-end) 100%);
            border: 1px solid var(--modal-border);
            border-radius: 12px;
            box-shadow:
                0 24px 80px var(--modal-shadow),
                inset 0 1px 0 color-mix(in srgb, var(--accent-cyan) 10%, transparent);
        }

        .execution-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.875rem 1.05rem;
            border-bottom: 1px solid var(--border-dim);
            background: linear-gradient(180deg, var(--modal-header-start) 0%, var(--modal-header-end) 100%);
        }

        .execution-modal-header h3 {
            margin: 0;
            font-size: 0.96rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .execution-modal-close {
            border: 1px solid var(--border-dim);
            border-radius: 8px;
            background: linear-gradient(180deg, var(--modal-close-bg), color-mix(in srgb, var(--bg-base) 90%, var(--bg-deep)));
            color: var(--text-secondary);
            font-family: var(--font-mono);
            font-size: 0.7rem;
            padding: 0.35rem 0.68rem;
            cursor: pointer;
        }

        .execution-modal-close:hover {
            border-color: color-mix(in srgb, var(--accent-cyan) 55%, transparent);
            color: var(--text-primary);
        }

        .execution-modal-body {
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .execution-detail-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 0.75rem;
            margin-bottom: 0.9rem;
        }

        .execution-detail-card {
            position: relative;
            background: linear-gradient(180deg, var(--modal-card-start), var(--modal-card-end));
            border: 1px solid color-mix(in srgb, var(--modal-border) 72%, transparent);
            border-radius: 10px;
            padding: 0.68rem 0.8rem;
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--text-primary) 5%, transparent);
            overflow: hidden;
        }

        .execution-detail-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--card-accent, var(--modal-card-outcome-accent));
        }

        .execution-detail-card--step { --card-accent: var(--modal-card-step-accent); }
        .execution-detail-card--action { --card-accent: var(--modal-card-action-accent); }
        .execution-detail-card--outcome { --card-accent: var(--modal-card-outcome-accent); }
        .execution-detail-card--verdict { --card-accent: var(--modal-card-verdict-accent); }
        .execution-detail-card--confidence { --card-accent: var(--modal-card-confidence-accent); }
        .execution-detail-card--input { --card-accent: var(--modal-card-input-accent); }
        .execution-detail-card--from { --card-accent: color-mix(in srgb, var(--modal-card-outcome-accent) 72%, transparent); }
        .execution-detail-card--to { --card-accent: color-mix(in srgb, var(--modal-card-outcome-accent) 72%, transparent); }

        .execution-detail-value .verdict,
        .execution-detail-value .outcome {
            font-size: 0.6875rem;
        }

        .execution-detail-label {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            margin-bottom: 0.25rem;
        }

        .execution-detail-value {
            font-size: 0.84rem;
            color: var(--text-secondary);
            word-break: break-word;
        }

        .execution-focus-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 0.75rem;
        }

        .execution-focus-card {
            background: linear-gradient(180deg, var(--modal-focus-start), var(--modal-focus-end));
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            padding: 0.72rem 0.8rem;
        }

        .execution-focus-card.expected {
            border-color: color-mix(in srgb, var(--accent-purple) 36%, transparent);
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--accent-purple) 18%, transparent);
        }

        .execution-focus-card.actual {
            border-color: color-mix(in srgb, var(--accent-cyan) 34%, transparent);
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--accent-cyan) 17%, transparent);
        }

        .execution-focus-card.selector {
            border-color: color-mix(in srgb, var(--accent-amber) 38%, transparent);
            box-shadow: inset 0 1px 0 color-mix(in srgb, var(--accent-amber) 14%, transparent);
        }

        .execution-focus-header {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            margin-bottom: 0.45rem;
        }

        .step-tag.selector {
            color: var(--accent-amber);
            background: var(--accent-amber-dim);
            border: 1px solid rgba(251, 191, 36, 0.25);
        }

        .execution-focus-body {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.5;
            word-break: break-word;
        }

        .execution-detail-text {
            background: linear-gradient(180deg, var(--modal-text-start), var(--modal-text-end));
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            padding: 0.75rem 0.8rem;
            font-size: 0.82rem;
            color: var(--text-secondary);
            line-height: 1.5;
            word-break: break-word;
        }

        .execution-detail-text strong {
            color: var(--text-primary);
        }

        .execution-detail-image {
            width: 100%;
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            background: var(--bg-overlay);
        }

        .evidence-cell {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .evidence-thumb-link {
            display: inline-flex;
            border: 1px solid var(--border-dim);
            border-radius: 6px;
            overflow: hidden;
            background: var(--bg-overlay);
        }

        .evidence-thumb {
            width: 40px;
            height: 28px;
            object-fit: cover;
            display: block;
        }

        .evidence-open-link {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--accent-cyan);
            text-decoration: none;
        }

        .evidence-open-link:hover { text-decoration: underline; }

        /* --- Outcome badges --- */
        .outcome {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 0.1875rem 0.5rem;
            border-radius: 4px;
            white-space: nowrap;
        }

        .outcome.navigation {
            color: var(--accent-green);
            background: var(--accent-green-dim);
        }
        .outcome.dom_change {
            color: var(--accent-amber);
            background: var(--accent-amber-dim);
        }
        .outcome.no_change {
            color: var(--text-muted);
            background: #4a5f7815;
        }
        .outcome.timeout,
        .outcome.validation_error,
        .outcome.network_error,
        .outcome.console_error,
        .outcome.exception {
            color: var(--accent-red);
            background: var(--accent-red-dim);
        }

        /* --- Graph --- */
        #graph-container {
            height: 400px;
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
            position: relative;
            overflow: hidden;
        }

        #graph-container::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 50% 50%, var(--accent-green-glow) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        .graph-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 0.75rem;
            padding: 0 0.25rem;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-muted);
        }

        .legend-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            box-shadow: 0 0 6px currentColor;
        }

        /* ============================================================
           FOOTER
           ============================================================ */
        .report-footer {
            margin-top: 4rem;
            padding: 1.5rem 0;
            border-top: 1px solid var(--border-dim);
            text-align: center;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-muted);
        }

        .report-footer span {
            background: linear-gradient(135deg, var(--accent-green), var(--accent-cyan));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 600;
        }

        /* ============================================================
           ANIMATIONS
           ============================================================ */
        @keyframes fade-up {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-in {
            animation: fade-up 0.5s ease forwards;
            opacity: 0;
        }

        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        /* === Scrollbar === */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border-base); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--border-bright); }

        /* === Screen reader only === */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        /* === Skip to content === */
        .skip-to-content {
            position: absolute;
            left: -9999px;
            top: 0;
            z-index: 100;
            padding: 0.5rem 1rem;
            background: var(--accent-green);
            color: var(--bg-deep);
            font-family: var(--font-mono);
            font-size: 0.8125rem;
            font-weight: 600;
            text-decoration: none;
            border-radius: 0 0 6px 0;
        }
        .skip-to-content:focus {
            left: 0;
        }

        /* === Focus indicators === */
        :focus-visible {
            outline: 2px solid var(--accent-cyan);
            outline-offset: 2px;
        }

        .page-btn:focus-visible,
        .filter-btn:focus-visible {
            outline: 2px solid var(--accent-cyan);
            outline-offset: 2px;
            box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-cyan) 20%, transparent);
        }

        .suite-header:focus-visible,
        .test-case-header:focus-visible,
        .section-collapsible .section-header:focus-visible {
            outline: 2px solid var(--accent-cyan);
            outline-offset: -2px;
            border-radius: 8px;
        }

        .execution-modal-close:focus-visible {
            outline: 2px solid var(--accent-cyan);
            outline-offset: 2px;
        }

        /* === Responsive — Tablet (768px) === */
        @media (max-width: 768px) {
            .header-meta {
                display: flex;
                gap: 0.4rem;
                margin-left: auto;
            }
            .header-meta .meta-runtime { display: none; }
            .theme-picker {
                padding: 0.2rem 0.28rem;
            }
            .theme-picker-label { display: none; }
            .theme-picker-select {
                min-width: 132px;
                font-size: 0.625rem;
            }
            .dashboard { grid-template-columns: 1fr; }
            .pass-rate-ring { width: 140px; height: 140px; }
            .pass-rate-ring-inner { width: 90px; height: 90px; }
            .pass-rate-pct { font-size: 1.5rem; }
            .metric-cards { grid-template-columns: repeat(2, 1fr); }
            .metric-value { font-size: 1.25rem; }
            .coverage-label { width: 100px; }
            .filter-toolbar { flex-direction: column; align-items: stretch; }
            .search-box { width: 100%; margin-left: 0; }
            .page-nav { overflow-x: auto; -webkit-overflow-scrolling: touch; flex-wrap: nowrap; }
            .page-btn { min-height: 44px; display: inline-flex; align-items: center; }
            .filter-btn { min-height: 44px; }
        }

        /* === Responsive — Mobile (480px) === */
        @media (max-width: 480px) {
            .metric-cards { grid-template-columns: 1fr; }
            .page-nav { gap: 0.35rem; }
            .page-btn { font-size: 0.625rem; padding: 0.35rem 0.5rem; }
            .data-table-wrap { border-radius: 8px; }
            .data-table { display: block; overflow-x: auto; }
            .execution-modal-dialog { width: 95vw; max-height: 90vh; }
            .execution-detail-grid { grid-template-columns: 1fr; }
            .execution-focus-grid { grid-template-columns: 1fr; }
            .diagnostics-grid { grid-template-columns: 1fr; }
            .elements-summary-grid { grid-template-columns: 1fr; }
            .elements-type-grid { grid-template-columns: 1fr; }
            .suite-header { padding: 0.625rem 0.75rem; }
            .suite-meta { gap: 0.25rem; }
            .tc-name { font-size: 0.8125rem; }
        }
    </style>
</head>
<body>

    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <!-- ============================================================
         SECTION A: HEADER
         ============================================================ -->
    <header class="report-header" role="banner">
        <div class="report-container">
            <div class="header-inner">
                <div class="brand">
                    <div class="brand-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#06080c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M12 2v4m0 12v4M2 12h4m12 0h4"/>
                            <path d="m4.93 4.93 2.83 2.83m8.48 8.48 2.83 2.83M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83"/>
                        </svg>
                    </div>
                    <div class="brand-text">flowscout</div>
                    <div class="brand-subtitle">Test Report</div>
                </div>
                <div class="header-meta">
                    <div class="header-meta-item meta-runtime">
                        <div class="header-meta-dot"></div>
                        <span>{{ started_at[:19] }} UTC</span>
                    </div>
                    <div class="header-meta-item meta-runtime">
                        <span>{{ "%.1f"|format(duration) }}s</span>
                    </div>
                    <div class="header-meta-item meta-runtime">
                        <span>{{ config_strategy }}</span>
                    </div>
                    <div class="header-meta-item">
                        <label class="theme-picker" for="theme-picker-select">
                            <span class="theme-picker-label">Theme</span>
                            <select id="theme-picker-select" class="theme-picker-select" aria-label="Select report theme">
                                <option value="catppuccin-mocha">Catppuccin Mocha</option>
                                <option value="catppuccin-macchiato">Catppuccin Macchiato</option>
                                <option value="catppuccin-frappe">Catppuccin Frappe</option>
                                <option value="catppuccin-latte">Catppuccin Latte</option>
                                <option value="dracula">Dracula</option>
                                <option value="github-dark">GitHub Dark</option>
                                <option value="github-light">GitHub Light</option>
                                <option value="nord">Nord</option>
                                <option value="solarized-dark">Solarized Dark</option>
                                <option value="solarized-light">Solarized Light</option>
                                <option value="rose-pine">Rosé Pine</option>
                                <option value="rose-pine-moon">Rosé Pine Moon</option>
                                <option value="rose-pine-dawn">Rosé Pine Dawn</option>
                                <option value="tokyo-night-dark">Tokyo Night Dark</option>
                                <option value="tokyo-night-storm">Tokyo Night Storm</option>
                                <option value="tokyo-night-light">Tokyo Night Light</option>
                                <option value="gruvbox-dark-hard">Gruvbox Dark Hard</option>
                                <option value="gruvbox-dark">Gruvbox Dark</option>
                                <option value="gruvbox-dark-soft">Gruvbox Dark Soft</option>
                                <option value="gruvbox-light-hard">Gruvbox Light Hard</option>
                                <option value="gruvbox-light">Gruvbox Light</option>
                                <option value="gruvbox-light-soft">Gruvbox Light Soft</option>
                                <option value="bulma-dark">Bulma Dark</option>
                                <option value="bulma-light">Bulma Light</option>
                            </select>
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main id="main-content" class="report-container" role="main">
        <nav class="page-nav animate-in" role="navigation" aria-label="Report sections">
            <button class="page-btn active" data-page="dashboard" onclick="setReportPage('dashboard', this)">Dashboard</button>
            <button class="page-btn" data-page="quality" onclick="setReportPage('quality', this)">Quality</button>
            <button class="page-btn" data-page="test-flows" onclick="setReportPage('test-flows', this)">Test Flows</button>
            <button class="page-btn" data-page="page-objects" onclick="setReportPage('page-objects', this)">Page Objects</button>
            <button class="page-btn" data-page="site-map" onclick="setReportPage('site-map', this)">Site Map</button>
            <button class="page-btn" data-page="execution-log" onclick="setReportPage('execution-log', this)">Execution Log</button>
        </nav>

        <!-- Target URL -->
        <div class="target-banner animate-in" data-report-page="dashboard">
            <div>
                <div class="target-label">target</div>
                <div class="target-url">{{ start_url }}</div>
            </div>
        </div>

        <!-- ============================================================
             SECTION B: DASHBOARD
             ============================================================ -->
        {% set pass_pct = coverage.pass_rate.pct %}
        {% set fail_pct = (flow_counts.fail / [flows|length, 1]|max * 100)|round|int %}
        {% set warn_pct = (flow_counts.warn / [flows|length, 1]|max * 100)|round|int %}
        {% set inventory_total = element_inventory.total_elements if element_inventory else 0 %}

        <div class="dashboard animate-in delay-1" data-report-page="dashboard">
            <!-- Pass rate donut -->
            <div class="pass-rate-ring" style="background: conic-gradient(
                var(--accent-green) 0deg {{ (pass_pct * 3.6)|round|int }}deg,
                var(--accent-red) {{ (pass_pct * 3.6)|round|int }}deg {{ ((pass_pct + fail_pct) * 3.6)|round|int }}deg,
                var(--accent-amber) {{ ((pass_pct + fail_pct) * 3.6)|round|int }}deg {{ ((pass_pct + fail_pct + warn_pct) * 3.6)|round|int }}deg,
                var(--bg-overlay) {{ ((pass_pct + fail_pct + warn_pct) * 3.6)|round|int }}deg 360deg
            );">
                <div class="pass-rate-ring-inner">
                    <div class="pass-rate-pct">{{ pass_pct }}%</div>
                    <div class="pass-rate-label">Passed</div>
                </div>
            </div>

            <!-- Right panel: metric cards + coverage bars -->
            <div class="dashboard-right">
                <div class="metric-cards">
                    <!-- Test Cases -->
                    <div class="metric-card">
                        <div class="metric-value">{{ flows|length }}</div>
                        <div class="metric-label">Test Cases</div>
                        {% if flows|length > 0 %}
                        <div class="metric-breakdown">
                            {% if flow_counts.pass %}<div class="metric-breakdown-bar" style="width: {{ flow_counts.pass / flows|length * 100 }}%; background: var(--accent-green);"></div>{% endif %}
                            {% if flow_counts.fail %}<div class="metric-breakdown-bar" style="width: {{ flow_counts.fail / flows|length * 100 }}%; background: var(--accent-red);"></div>{% endif %}
                            {% if flow_counts.warn %}<div class="metric-breakdown-bar" style="width: {{ flow_counts.warn / flows|length * 100 }}%; background: var(--accent-amber);"></div>{% endif %}
                        </div>
                        {% endif %}
                    </div>

                    <!-- Test Steps -->
                    <div class="metric-card">
                        <div class="metric-value">{{ total_test_steps }}</div>
                        <div class="metric-label">Test Steps</div>
                        {% if total_test_steps > 0 %}
                        <div class="metric-breakdown">
                            {% if step_verdicts_summary.pass %}<div class="metric-breakdown-bar" style="width: {{ step_verdicts_summary.pass / total_test_steps * 100 }}%; background: var(--accent-green);"></div>{% endif %}
                            {% if step_verdicts_summary.fail %}<div class="metric-breakdown-bar" style="width: {{ step_verdicts_summary.fail / total_test_steps * 100 }}%; background: var(--accent-red);"></div>{% endif %}
                            {% if step_verdicts_summary.warn %}<div class="metric-breakdown-bar" style="width: {{ step_verdicts_summary.warn / total_test_steps * 100 }}%; background: var(--accent-amber);"></div>{% endif %}
                        </div>
                        {% endif %}
                    </div>

                    <!-- Pages Discovered -->
                    <div class="metric-card">
                        <div class="metric-value cyan">{{ states|length }}</div>
                        <div class="metric-label">Pages</div>
                    </div>

                    <!-- Duration -->
                    <div class="metric-card">
                        <div class="metric-value blue">{{ "%.1f"|format(duration) }}<span style="font-size: 0.75rem; font-weight: 400; color: var(--text-muted);">s</span></div>
                        <div class="metric-label">Duration</div>
                    </div>

                    {% if inventory_total > 0 %}
                    <div class="metric-card">
                        <div class="metric-value green">{{ element_inventory.interactive_elements }}</div>
                        <div class="metric-label">Interactive Elements</div>
                    </div>

                    <div class="metric-card">
                        <div class="metric-value amber">{{ element_inventory.non_interactive_elements }}</div>
                        <div class="metric-label">Content Elements</div>
                    </div>
                    {% endif %}
                </div>

                <!-- Coverage bars -->
                <div class="coverage-bars">
                    <div class="coverage-row">
                        <div class="coverage-label">Page Coverage</div>
                        <div class="coverage-track">
                            <div class="coverage-fill cyan" style="width: {{ coverage.page.pct }}%;"></div>
                        </div>
                        <div class="coverage-pct">{{ coverage.page.tested }}/{{ coverage.page.total }} ({{ coverage.page.pct }}%)</div>
                    </div>
                    <div class="coverage-row">
                        <div class="coverage-label">Interaction</div>
                        <div class="coverage-track">
                            <div class="coverage-fill blue" style="width: {{ coverage.interaction.pct }}%;"></div>
                        </div>
                        <div class="coverage-pct">{{ coverage.interaction.executed }}/{{ coverage.interaction.total }} ({{ coverage.interaction.pct }}%)</div>
                    </div>
                    <div class="coverage-row">
                        <div class="coverage-label">Pass Rate</div>
                        <div class="coverage-track">
                            <div class="coverage-fill green" style="width: {{ coverage.pass_rate.pct }}%;"></div>
                        </div>
                        <div class="coverage-pct">{{ coverage.pass_rate.passed }}/{{ coverage.pass_rate.total }} ({{ coverage.pass_rate.pct }}%)</div>
                    </div>
                    {% if inventory_total > 0 %}
                    <div class="coverage-row">
                        <div class="coverage-label">Interactive Mix</div>
                        <div class="coverage-track">
                            <div class="coverage-fill green" style="width: {{ element_inventory.interactive_pct }}%;"></div>
                        </div>
                        <div class="coverage-pct">{{ element_inventory.interactive_elements }}/{{ element_inventory.total_elements }} ({{ element_inventory.interactive_pct }}%)</div>
                    </div>
                    {% endif %}
                </div>
                <div class="quick-actions">
                    <button class="filter-btn" onclick="jumpToTestCases('all')">Open Test Cases</button>
                    {% if flow_counts.fail %}
                    <button class="filter-btn active-fail" onclick="jumpToTestCases('fail')">Focus Failures ({{ flow_counts.fail }})</button>
                    {% endif %}
                    {% if flow_counts.warn %}
                    <button class="filter-btn active-warn" onclick="jumpToTestCases('warn')">Focus Warnings ({{ flow_counts.warn }})</button>
                    {% endif %}
                </div>
                <div class="input-provenance">
                    <div class="input-provenance-title">Input Data Source</div>
                    <div class="input-provenance-meta">
                        Profile: <strong>{{ input_provenance.profile }}</strong> · Fill actions: <strong>{{ input_provenance.fill_actions }}</strong>
                    </div>
                    {% if input_provenance.source_breakdown %}
                    <div class="diag-reason-list">
                        {% for item in input_provenance.source_breakdown %}
                        <span class="diag-chip">{{ item.source }} ({{ item.count }})</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if locator_quality_rows %}
        <section id="locator-quality" class="section animate-in delay-2" data-report-page="dashboard">
            <div class="section-header">
                <h2>Locator Quality</h2>
                <div class="section-count">{{ locator_quality_rows|length }} page types</div>
                <div class="section-line"></div>
            </div>
            <div class="coverage-table-wrap">
                <table>
                    <caption class="sr-only">Locator quality by page type</caption>
                    <thead>
                        <tr>
                            <th>Page Type</th>
                            <th>Quality</th>
                            <th>Selectors</th>
                            <th>Instances</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in locator_quality_rows %}
                        <tr>
                            <td>{{ row.name }}</td>
                            <td>{{ row.quality_text }}</td>
                            <td>{{ row.selector_count }}</td>
                            <td>{{ row.instance_count }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if locator_recommendations %}
            <div class="diag-reason-list" style="margin-top: 0.75rem;">
                {% for recommendation in locator_recommendations %}
                <span class="diag-chip">{{ recommendation }}</span>
                {% endfor %}
            </div>
            {% endif %}
        </section>
        {% endif %}

        <!-- ============================================================
             SECTION G: DEFECTS (shown above test suites if failures exist)
             ============================================================ -->
        {% if defects.failures or defects.warnings %}
        <section id="defects" class="section animate-in delay-2" data-report-page="dashboard">
            <div class="section-header">
                <h2 style="color: var(--accent-red);">Defects</h2>
                <div class="section-count" style="color: var(--accent-red); border-color: var(--accent-red-dim);">{{ defects.failures|length + defects.warnings|length }}</div>
                <div class="section-line"></div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                {% for flow in defects.failures %}
                <div class="defect-card" onclick="expandTestCase('{{ flow.flow_id }}')">
                    <div class="defect-header">
                        <span class="verdict fail">fail</span>
                        <span class="defect-name">{{ flow.name }}</span>
                    </div>
                    <div class="defect-detail">
                        {% if flow.narrative and flow.narrative.conclusion %}
                        {{ flow.narrative.conclusion }}
                        {% else %}
                        Stability score: {{ "%.2f"|format(flow.stability_score or 0.0) }}
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
                {% for flow in defects.warnings %}
                <div class="defect-card warning" onclick="expandTestCase('{{ flow.flow_id }}')">
                    <div class="defect-header">
                        <span class="verdict warn">warn</span>
                        <span class="defect-name">{{ flow.name }}</span>
                    </div>
                    <div class="defect-detail">
                        {% if flow.narrative and flow.narrative.conclusion %}
                        {{ flow.narrative.conclusion }}
                        {% else %}
                        Stability score: {{ "%.2f"|format(flow.stability_score or 0.0) }}
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        <!-- ============================================================
             SECTION H: QUALITY OVERVIEW
             ============================================================ -->
        <section id="quality-overview" class="section animate-in delay-2" data-report-page="quality">
            <div class="section-header">
                <h2>Quality Overview</h2>
                <div class="section-count">{{ quality_insights.recommendations|length }} recommendations</div>
                <div class="section-line"></div>
            </div>
            <div class="diagnostics-grid">
                <div class="diag-card">
                    <div class="diag-label">Locator Health Issues</div>
                    <div class="diag-value {% if quality_insights.locator_issue_count %}warn{% else %}pass{% endif %}">{{ quality_insights.locator_issue_count }}</div>
                    <div class="diag-subtext">Page types with fragile selectors or sub-80 quality score</div>
                </div>
                <div class="diag-card">
                    <div class="diag-label">Flaky Actions</div>
                    <div class="diag-value {% if quality_insights.flaky_action_count %}fail{% else %}pass{% endif %}">{{ quality_insights.flaky_action_count }}</div>
                    <div class="diag-subtext">Transitions with inconsistent outcomes from the same page/action</div>
                </div>
                <div class="diag-card">
                    <div class="diag-label">Low-Stability Steps</div>
                    <div class="diag-value {% if quality_insights.low_stability_count %}warn{% else %}pass{% endif %}">{{ quality_insights.low_stability_count }}</div>
                    <div class="diag-subtext">Steps below {{ "%.0f"|format(diagnostics.low_confidence_threshold * 100) }}% confidence</div>
                </div>
            </div>

            {% if quality_insights.locator_health_rows %}
            <div class="data-table-wrap" style="margin-top: 1rem;">
                <div class="elements-subtitle-small">Locator Health</div>
                <div class="table-scroll">
                    <table class="data-table">
                        <caption class="sr-only">Locator health by page type</caption>
                        <thead>
                            <tr>
                                <th>Page Type</th>
                                <th class="right">Quality</th>
                                <th class="right">Fragile</th>
                                <th class="right">Instances</th>
                                <th>Recommendation</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in quality_insights.locator_health_rows %}
                            <tr>
                                <td class="cell-action">{{ row.name }}</td>
                                <td class="cell-right">{{ row.quality_score }}%</td>
                                <td class="cell-right">{{ row.fragile_count }}</td>
                                <td class="cell-right">{{ row.instance_count }}</td>
                                <td class="cell-dim">{{ row.recommendation }}</td>
                                <td>
                                    <button class="filter-btn" onclick="openPageObjectCard('{{ row.anchor_id }}')">Open Page Object</button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}

            {% if quality_insights.flaky_actions %}
            <div class="data-table-wrap" style="margin-top: 1rem;">
                <div class="elements-subtitle-small">Flaky Actions</div>
                <div class="table-scroll">
                    <table class="data-table">
                        <caption class="sr-only">Flaky actions with links to affected flows</caption>
                        <thead>
                            <tr>
                                <th>Page</th>
                                <th>Action</th>
                                <th>Outcomes</th>
                                <th class="right">Occurrences</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in quality_insights.flaky_actions %}
                            <tr>
                                <td class="cell-action">{{ row.source_page }}</td>
                                <td class="cell-action">{{ row.action_label }}</td>
                                <td class="cell-dim">{{ row.outcomes|join(', ') }}</td>
                                <td class="cell-right">{{ row.occurrences }}</td>
                                <td>
                                    {% if row.flow_id %}
                                    <button class="filter-btn" onclick="openFlowFromSiteMap('{{ row.flow_id }}', '{{ row.template_id }}')">Open Flow</button>
                                    {% else %}
                                    <span class="cell-dim">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}

            {% if quality_insights.low_stability_steps %}
            <div class="data-table-wrap" style="margin-top: 1rem;">
                <div class="elements-subtitle-small">Low-Stability Steps</div>
                <div class="table-scroll">
                    <table class="data-table">
                        <caption class="sr-only">Low-confidence steps with jump links</caption>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Page</th>
                                <th>Action</th>
                                <th class="right">Confidence</th>
                                <th>Reason</th>
                                <th>Flow</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in quality_insights.low_stability_steps %}
                            <tr>
                                <td class="cell-dim">{{ row.step_index }}</td>
                                <td class="cell-action">{{ row.source_page }}</td>
                                <td class="cell-action">{{ row.action_label }}</td>
                                <td class="cell-right">{{ row.confidence_pct }}%</td>
                                <td class="cell-dim">{{ row.confidence_reason }}</td>
                                <td class="cell-dim">
                                    {% if row.flow_name %}
                                    {{ row.flow_name }}{% if row.flow_step %} · step {{ row.flow_step }}{% endif %}
                                    {% else %}
                                    —
                                    {% endif %}
                                </td>
                                <td>
                                    <button class="filter-btn" onclick="jumpToExecutionStep({{ row.step_index }})">Open Step</button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}

            {% if quality_insights.recommendations %}
            <div class="data-table-wrap" style="margin-top: 1rem;">
                <div class="elements-subtitle-small">Improvement Recommendations</div>
                <div style="display: flex; flex-direction: column; gap: 0.625rem; margin-top: 0.5rem;">
                    {% for row in quality_insights.recommendations %}
                    <div class="defect-card warning">
                        <div class="defect-header" style="display: flex; justify-content: space-between; gap: 0.5rem; align-items: center;">
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                <span class="verdict {% if row.priority == 'high' %}fail{% elif row.priority == 'medium' %}warn{% else %}pass{% endif %}">{{ row.priority }}</span>
                                <span class="defect-name">{{ row.title }}</span>
                            </div>
                            {% if row.link_kind == 'page_object' %}
                            <button class="filter-btn" onclick="openPageObjectCard('{{ row.link_value }}')">Open Page Object</button>
                            {% elif row.link_kind == 'flow' %}
                            <button class="filter-btn" onclick="expandTestCase('{{ row.link_value }}')">Open Flow</button>
                            {% elif row.link_kind == 'step' %}
                            <button class="filter-btn" onclick="jumpToExecutionStep({{ row.link_value }})">Open Step</button>
                            {% endif %}
                        </div>
                        <div class="defect-detail">{{ row.detail }}</div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </section>

        <!-- ============================================================
             SECTION H: DIAGNOSTICS
             ============================================================ -->
        <section id="diagnostics-section" class="section section-collapsible collapsed animate-in delay-2" data-report-page="quality">
            <div class="section-header" role="button" tabindex="0" aria-expanded="false" onclick="toggleSection(this.parentElement)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleSection(this.parentElement)}">
                <svg class="section-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                <h2>Exploration Diagnostics</h2>
                <div class="section-count">{{ diagnostics.low_confidence_count }} low-confidence &middot; {{ diagnostics.flaky_paths_count }} flaky</div>
                <div class="section-line"></div>
            </div>
            <div class="section-body">
                <div class="diagnostics-grid">
                    <div class="diag-card">
                        <div class="diag-label">Low-Confidence Steps</div>
                        <div class="diag-value {% if diagnostics.low_confidence_count %}warn{% else %}pass{% endif %}">{{ diagnostics.low_confidence_count }}</div>
                        <div class="diag-subtext">
                            Below {{ "%.0f"|format(diagnostics.low_confidence_threshold * 100) }}% confidence
                            ({{ diagnostics.low_confidence_pct }}% of {{ diagnostics.total_steps }} steps)
                        </div>
                    </div>
                    <div class="diag-card">
                        <div class="diag-label">Flaky Transitions</div>
                        <div class="diag-value {% if diagnostics.flaky_paths_count %}fail{% else %}pass{% endif %}">{{ diagnostics.flaky_paths_count }}</div>
                        <div class="diag-subtext">
                            Same state + action produced multiple outcomes in this run
                        </div>
                    </div>
                    <div class="diag-card">
                        <div class="diag-label">Top Low-Confidence Reasons</div>
                        {% if diagnostics.reason_breakdown %}
                        <div class="diag-reason-list">
                            {% for reason in diagnostics.reason_breakdown %}
                            <span class="diag-chip">{{ reason.reason }} ({{ reason.count }})</span>
                            {% endfor %}
                        </div>
                        {% else %}
                        <div class="diag-value pass">none</div>
                        <div class="diag-subtext">No low-confidence transitions were detected.</div>
                        {% endif %}
                    </div>
                </div>

                {% if diagnostics.low_confidence_items %}
                <div class="data-table-wrap" style="margin-bottom: 1rem;">
                    <div class="table-scroll">
                        <table class="data-table">
                            <caption class="sr-only">Low-confidence exploration steps</caption>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Page</th>
                                    <th>Flow</th>
                                    <th>Step</th>
                                    <th>Outcome</th>
                                    <th>Confidence</th>
                                    <th>Reason</th>
                                    <th>Detail</th>
                                    <th>Evidence</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in diagnostics.low_confidence_items %}
                                <tr class="diagnostic-row" onclick="jumpToExecutionStep({{ item.step_index }})" title="Open step {{ item.step_index }} in its flow timeline">
                                    {% set flow_ctx = execution_step_map.get(item.step_index) %}
                                    <td class="cell-dim">{{ item.step_index }}</td>
                                    <td class="cell-action" title="{{ item.source_page }}">{{ item.source_page }}</td>
                                    <td class="cell-action">
                                        {% if flow_ctx %}
                                        {{ flow_ctx.flow_name }} &middot; step {{ flow_ctx.flow_step }}
                                        {% else %}
                                        <span class="cell-dim">unmapped</span>
                                        {% endif %}
                                    </td>
                                    <td class="cell-action">
                                        <div>{{ item.action_label }}</div>
                                        <div class="diag-step-meta">
                                            {% if item.expected %}<span class="meta-line">Expected: {{ item.expected }}</span>{% endif %}
                                            {% if item.actual %}<span class="meta-line">Actual: {{ item.actual }}</span>{% endif %}
                                        </div>
                                    </td>
                                    <td><span class="outcome {{ item.outcome }}">{{ item.outcome }}</span></td>
                                    <td class="confidence-cell">{{ item.confidence_pct }}%</td>
                                    <td class="cell-dim confidence-reason">{{ item.confidence_reason }}</td>
                                    <td class="cell-dim confidence-reason" title="{{ item.detail }}">{{ item.detail or "—" }}</td>
                                    <td>
                                        {% if item.evidence_link %}
                                        <div class="evidence-cell">
                                            <a class="evidence-thumb-link" href="{{ item.evidence_link }}" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">
                                                <img class="evidence-thumb" src="{{ item.evidence_link }}" alt="evidence step {{ item.step_index }}" loading="lazy">
                                            </a>
                                            <a class="evidence-open-link" href="{{ item.evidence_link }}" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">open</a>
                                        </div>
                                        {% else %}
                                        <span class="cell-dim">—</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% endif %}

                {% if diagnostics.flaky_items %}
                <div class="data-table-wrap">
                    <div class="table-scroll">
                        <table class="data-table">
                            <caption class="sr-only">Flaky transitions</caption>
                            <thead>
                                <tr>
                                    <th>Page</th>
                                    <th>Step</th>
                                    <th>Outcomes</th>
                                    <th class="right">Occurrences</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in diagnostics.flaky_items %}
                                <tr>
                                    <td class="cell-action" title="{{ item.source_page }}">{{ item.source_page }}</td>
                                    <td class="cell-action">{{ item.action_label }}</td>
                                    <td class="cell-dim">{{ item.outcomes|join(', ') }}</td>
                                    <td class="cell-right">{{ item.occurrences }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% endif %}
            </div>
        </section>

        <!-- ============================================================
             SECTION C: FLOW TEMPLATES (primary view)
             ============================================================ -->
        <section id="test-suites" class="section animate-in delay-2" data-report-page="test-flows">
            <div class="section-header">
                <h2>Flow Templates</h2>
                <div class="section-count">{{ flow_template_cards|length }} templates · {{ flows|length }} instances</div>
                <div class="section-line"></div>
            </div>

            <div class="filter-toolbar" role="toolbar" aria-label="Filter test cases">
                <button class="filter-btn active" data-filter="all" onclick="filterTestCases('all', this)">All ({{ flow_template_cards|length }})</button>
                <button class="filter-btn" data-filter="pass" onclick="filterTestCases('pass', this)">Stable</button>
                <button class="filter-btn" data-filter="fail" onclick="filterTestCases('fail', this)">Risky</button>
                <button class="filter-btn" data-filter="warn" onclick="filterTestCases('warn', this)">Mixed</button>
                <input type="text" class="search-box" placeholder="Search flow templates..." aria-label="Search test cases" oninput="searchTestCases(this.value)">
                <input type="text" id="template-type-filter" class="search-box" placeholder="Template type (click, fill...)" aria-label="Filter by template type" oninput="filterFlowTemplates()">
                <select id="template-stability-filter" class="search-box" aria-label="Filter by stability" onchange="filterFlowTemplates()">
                    <option value="all">All stability</option>
                    <option value="stable">Stable</option>
                    <option value="warn">Mixed</option>
                    <option value="risky">Risky</option>
                </select>
                <input type="text" id="template-tag-filter" class="search-box" placeholder="Filter by tag..." aria-label="Filter by tags" oninput="filterFlowTemplates()">
            </div>

            {% if flow_template_cards %}
            {% for card in flow_template_cards %}
            <article
                class="test-suite flow-template-card"
                id="flow-template-{{ card.anchor_id }}"
                data-template-id="{{ card.template_id }}"
                data-template-type="{{ card.template_type }}"
                data-stability="{{ card.stability_bucket }}"
                data-tags="{{ card.tags|join(' ')|lower }}"
                data-name="{{ card.name|lower }}"
                data-stable-count="{{ card.stable_count }}"
                data-fail-count="{{ card.fail_count }}"
                data-warn-count="{{ card.warn_count }}"
            >
                <div class="suite-header" role="button" tabindex="0" aria-expanded="true" onclick="toggleSuite(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleSuite(this)}">
                    <svg class="suite-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                    <span class="suite-name">{{ card.name }}</span>
                    <div class="suite-meta">
                        <span class="suite-stat">{{ card.occurrence_count }} instances</span>
                        <span class="suite-stat {% if card.stability_bucket == 'stable' %}pass{% elif card.stability_bucket == 'risky' %}fail{% else %}warn{% endif %}">
                            {{ card.stability_pct }}% stable
                        </span>
                        {% if card.tags %}
                        <div class="tc-tags">
                            {% for tag in card.tags %}
                            <span class="tc-tag">{{ tag }}</span>
                            {% endfor %}
                        </div>
                        {% endif %}
                        <div class="section-count">{{ card.template_type }}</div>
                    </div>
                </div>
                <div class="suite-body">
                    {% set flow = card.representative_flow %}
                    <details class="test-case" data-verdict="{% if card.stability_bucket == 'stable' %}pass{% elif card.stability_bucket == 'risky' %}fail{% else %}warn{% endif %}" data-flow-id="{{ flow.flow_id }}" data-name="{{ flow.name|lower }}">
                        <summary class="test-case-header">
                            <div class="test-case-left">
                                <span class="verdict {% if card.stability_bucket == 'stable' %}pass{% elif card.stability_bucket == 'risky' %}fail{% else %}warn{% endif %}">
                                    representative
                                </span>
                                <span class="tc-name">{{ flow.name }}</span>
                            </div>
                            <div class="test-case-right">
                                <span class="tc-steps-count">{{ flow.depth }} step{{ 's' if flow.depth != 1 }}</span>
                                <svg class="tc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                            </div>
                        </summary>
                        <div class="test-case-body">
                            {% if flow.narrative and flow.narrative.precondition %}
                            <div class="precondition">{{ flow.narrative.precondition }}</div>
                            {% endif %}
                            {% if flow.narrative and flow.narrative.steps %}
                            <div class="step-timeline">
                                {% for step in flow.narrative.steps %}
                                {% if step.is_stable %}
                                {% set sv = 'pass' %}
                                {% elif step.outcome and step.outcome.value in ['network_error', 'timeout', 'exception'] %}
                                {% set sv = 'fail' %}
                                {% else %}
                                {% set sv = 'warn' %}
                                {% endif %}
                                <div class="step-item {{ sv }}">
                                    <div class="step-number">{{ step.step_number }}</div>
                                    <div class="step-content">
                                        <div class="step-action-row">
                                            <span class="step-action-text">{{ step.action_description }}</span>
                                            <span class="verdict {{ sv }}">{{ sv }}</span>
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                            {% else %}
                            <div style="margin-top: 0.75rem; font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.5; word-break: break-all;">{{ flow.description }}</div>
                            {% endif %}

                            {% if card.representative_rows %}
                            <div class="data-table-wrap" style="margin-top: 0.75rem;">
                                <div class="elements-subtitle-small">Representative Flow Timeline</div>
                                <div class="table-scroll">
                                    <table class="data-table">
                                        <caption class="sr-only">Representative flow timeline for {{ flow.name }}</caption>
                                        <thead>
                                            <tr>
                                                <th>Step</th>
                                                <th>From</th>
                                                <th>Action</th>
                                                <th>Locator</th>
                                                <th>Outcome</th>
                                                <th>Status</th>
                                                <th>Confidence</th>
                                                <th>Evidence</th>
                                                <th class="right">Duration</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for row in card.representative_rows %}
                                            <tr id="flow-step-{{ row.index }}" class="execution-log-row flow-step-row" onclick="openExecutionStepModal({{ row.index }})" title="Open detailed step view">
                                                <td class="cell-dim">{{ row.flow_step }}</td>
                                                <td class="cell-action">{{ row.source_page }}</td>
                                                <td class="cell-action">{{ row.action_label }}</td>
                                                <td class="cell-url">{{ row.target_selector or (('#' ~ row.dom_id) if row.dom_id else '—') }}</td>
                                                <td><span class="outcome {{ row.outcome }}">{{ row.outcome }}</span></td>
                                                <td>{% if row.verdict %}<span class="verdict {{ row.verdict }}">{{ row.verdict }}</span>{% else %}<span class="verdict inconclusive">n/a</span>{% endif %}</td>
                                                <td class="confidence-cell">{{ row.confidence_pct }}%</td>
                                                <td onclick="event.stopPropagation()">
                                                    {% if row.screenshot_link %}
                                                    <div class="evidence-cell">
                                                        <a class="evidence-thumb-link" href="{{ row.screenshot_link }}" target="_blank" rel="noopener noreferrer">
                                                            <img class="evidence-thumb" src="{{ row.screenshot_link }}" alt="evidence step {{ row.index }}" loading="lazy">
                                                        </a>
                                                        <a class="evidence-open-link" href="{{ row.screenshot_link }}" target="_blank" rel="noopener noreferrer">open</a>
                                                    </div>
                                                    {% else %}
                                                    <span class="cell-dim">—</span>
                                                    {% endif %}
                                                </td>
                                                <td class="cell-right">{{ row.duration_ms }}ms</td>
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    </details>

                    <details class="test-case" data-name="{{ card.name|lower }}">
                        <summary class="test-case-header">
                            <div class="test-case-left">
                                <span class="verdict">instances</span>
                                <span class="tc-name">Show all instances</span>
                            </div>
                            <div class="test-case-right">
                                <span class="tc-steps-count">{{ card.instances|length }} flows</span>
                                <svg class="tc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                            </div>
                        </summary>
                        <div class="test-case-body">
                            <div class="data-table-wrap">
                                <div class="table-scroll">
                                    <table class="data-table">
                                        <caption class="sr-only">All flow instances for {{ card.name }}</caption>
                                        <thead>
                                            <tr>
                                                <th>Flow</th>
                                                <th>Status</th>
                                                <th class="right">Stability</th>
                                                <th class="right">Steps</th>
                                                <th>Tags</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for instance in card.instances %}
                                            <tr data-flow-id="{{ instance.flow_id }}" onclick="openFlowInstance('{{ instance.flow_id }}', this)">
                                                <td class="cell-action">{{ instance.name }}</td>
                                                <td><span class="verdict {{ instance.status }}">{{ instance.status }}</span></td>
                                                <td class="cell-right">{{ "%.2f"|format(instance.stability_score) }}</td>
                                                <td class="cell-right">{{ instance.depth }}</td>
                                                <td class="cell-dim">{{ instance.tags|join(', ') if instance.tags else '-' }}</td>
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </details>
                </div>
            </article>
            {% endfor %}
            {% else %}
            <div class="untested-callout">
                <span class="callout-icon">&#9432;</span>
                <span>No flow templates available for this run.</span>
            </div>
            {% endif %}
        </section>

        <!-- ============================================================
             SECTION D: ELEMENT DISCOVERY
             ============================================================ -->
        <section id="page-objects-section" class="section animate-in delay-3" data-report-page="page-objects">
            <div class="section-header">
                <h2>Page Object Preview</h2>
                <div class="section-count">{{ page_object_cards|length }} page types</div>
                <div class="section-line"></div>
            </div>
            {% if page_object_cards %}
            <div class="page-object-grid">
                {% for card in page_object_cards %}
                <article
                    class="pom-card"
                    id="page-object-{{ card.anchor_id }}"
                    data-page-type-id="{{ card.page_type_id }}"
                >
                    <div class="pom-card-header">
                        <div>
                            <div class="pom-class-name">{{ card.class_name }}</div>
                            <div class="pom-page-name">{{ card.name }}</div>
                            <div class="pom-badges">
                                <span class="pom-badge">{{ card.archetype }}</span>
                                <span class="pom-badge">seen {{ card.instance_count }} times</span>
                            </div>
                        </div>
                        <div class="pom-quality {{ card.quality_tone }}">
                            {{ card.quality_score }}%
                        </div>
                    </div>
                    <div class="pom-submeta">{{ card.url_pattern or "unknown pattern" }}</div>

                    <details class="pom-card-details">
                        <summary>Open locator table and code preview</summary>
                        <div class="data-table-wrap">
                            <div class="table-scroll">
                                <table class="data-table">
                                    <caption class="sr-only">Locator table for {{ card.name }}</caption>
                                    <thead>
                                        <tr>
                                            <th>Selector</th>
                                            <th>Stability</th>
                                            <th>Zone</th>
                                            <th class="right">Exercised</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in card.locator_rows %}
                                        <tr>
                                            <td class="cell-url" title="{{ row.raw_selector }}">{{ row.selector }}</td>
                                            <td><span class="pom-stability {{ row.stability }}">{{ row.stability }}</span></td>
                                            <td class="cell-dim">{{ row.zone }}</td>
                                            <td class="cell-right">{{ "yes" if row.exercised else "no" }}</td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        {% if card.code_preview.python or card.code_preview.typescript %}
                        <div class="pom-code-tools">
                            {% if card.code_preview.python %}
                            <button class="pom-lang-btn active" onclick="togglePomCode('{{ card.anchor_id }}', 'python', this)">Python</button>
                            {% endif %}
                            {% if card.code_preview.typescript %}
                            <button class="pom-lang-btn {% if not card.code_preview.python %}active{% endif %}" onclick="togglePomCode('{{ card.anchor_id }}', 'typescript', this)">TypeScript</button>
                            {% endif %}
                        </div>
                        {% if card.code_preview.python %}
                        <pre class="pom-code-block active" data-lang="python"><code>{{ card.code_preview.python }}</code></pre>
                        {% endif %}
                        {% if card.code_preview.typescript %}
                        <pre class="pom-code-block {% if not card.code_preview.python %}active{% endif %}" data-lang="typescript"><code>{{ card.code_preview.typescript }}</code></pre>
                        {% endif %}
                        {% endif %}
                    </details>

                    {% if card.recommendations %}
                    <div class="diag-reason-list">
                        {% for recommendation in card.recommendations %}
                        <span class="diag-chip">{{ recommendation }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                </article>
                {% endfor %}
            </div>
            {% else %}
            <div class="untested-callout">
                <span class="callout-icon">&#9432;</span>
                <span>No page object previews available for this run.</span>
            </div>
            {% endif %}
        </section>

        <section id="elements-section" class="section animate-in delay-3" data-report-page="page-objects">
            <div class="section-header">
                <h2>Discovered Elements (Advanced)</h2>
                <div class="section-count">{{ element_inventory.total_elements if element_inventory else 0 }}</div>
                <div class="section-line"></div>
            </div>
            {% if element_inventory %}
            <div class="elements-summary-grid">
                <div class="diag-card">
                    <div class="diag-label">Interactive</div>
                    <div class="diag-value pass">{{ element_inventory.interactive_elements }}</div>
                </div>
                <div class="diag-card">
                    <div class="diag-label">Content</div>
                    <div class="diag-value warn">{{ element_inventory.non_interactive_elements }}</div>
                </div>
                <div class="diag-card">
                    <div class="diag-label">Pages Analyzed</div>
                    <div class="diag-value">{{ element_inventory.pages_with_elements }}</div>
                </div>
                <div class="diag-card">
                    <div class="diag-label">Interactive Mix</div>
                    <div class="diag-value">{{ element_inventory.interactive_pct }}%</div>
                </div>
            </div>

            {% if discovery_timeline %}
            <h3 class="elements-subtitle">State Discovery Progression</h3>
            <div class="elements-subtitle-hint">Click a row to inspect this specific state snapshot. Multiple states can share the same URL.</div>
            <div class="data-table-wrap" style="margin-bottom: 1rem;">
                <div class="table-scroll">
                    <table class="data-table">
                        <caption class="sr-only">State discovery progression</caption>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>State ID</th>
                                <th>Page</th>
                                <th class="right">Depth</th>
                                <th class="right">Interactive</th>
                                <th class="right">Content</th>
                                <th class="right">Total</th>
                                <th class="right">New vs prior</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in discovery_timeline %}
                            <tr class="elements-drilldown-row" onclick="openElementsDrilldown('{{ row.state_id }}', 'State Discovery Progression')" title="Open element details for this state">
                                <td class="cell-dim">{{ row.order }}</td>
                                <td class="cell-dim"><code>{{ row.state_short }}</code></td>
                                <td class="cell-action" title="{{ row.url }}">{{ row.title }}</td>
                                <td class="cell-right">{{ row.depth }}</td>
                                <td class="cell-right" style="color: var(--accent-green);">{{ row.interactive }}</td>
                                <td class="cell-right" style="color: var(--accent-amber);">{{ row.non_interactive }}</td>
                                <td class="cell-right">{{ row.total }}</td>
                                <td class="cell-right" style="color: {% if row.new_elements > 0 %}var(--accent-cyan){% else %}var(--text-muted){% endif %};">+{{ row.new_elements }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}

            <h3 class="elements-subtitle">Per-State Inventory</h3>
            <div class="elements-subtitle-hint">Each row is a unique state snapshot. Same URL can appear multiple times when DOM/form/content changed.</div>
            <div class="data-table-wrap" style="margin-bottom: 1rem;">
                <div class="table-scroll">
                    <table class="data-table">
                        <caption class="sr-only">Per-state element inventory</caption>
                        <thead>
                            <tr>
                                <th>State ID</th>
                                <th>Page</th>
                                <th>URL</th>
                                <th class="right">Interactive</th>
                                <th class="right">Content</th>
                                <th class="right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for page in element_inventory.per_page %}
                            <tr class="elements-drilldown-row" onclick="openElementsDrilldown('{{ page.state_id }}', 'Per-State Inventory')" title="Open element details for this state">
                                <td class="cell-dim"><code>{{ page.state_id[:8] }}</code></td>
                                <td class="cell-action">{{ page.title or page.url or 'Page' }}</td>
                                <td class="cell-url">{{ page.url }}</td>
                                <td class="cell-right" style="color: var(--accent-green);">{{ page.interactive_elements }}</td>
                                <td class="cell-right" style="color: var(--accent-amber);">{{ page.non_interactive_elements }}</td>
                                <td class="cell-right">{{ page.total_elements }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {% if url_inventory_rows %}
            <h3 class="elements-subtitle">Per-URL Inventory (Aggregated)</h3>
            <div class="elements-subtitle-hint">Merged by URL to reduce duplicate rows while preserving per-state counts above.</div>
            <div class="data-table-wrap" style="margin-bottom: 1rem;">
                <div class="table-scroll">
                    <table class="data-table">
                        <caption class="sr-only">Per-URL element inventory (aggregated)</caption>
                        <thead>
                            <tr>
                                <th>Page</th>
                                <th>URL</th>
                                <th class="right">States</th>
                                <th>State IDs</th>
                                <th class="right">Interactive</th>
                                <th class="right">Content</th>
                                <th class="right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in url_inventory_rows %}
                            <tr>
                                <td class="cell-action">{{ row.title or row.url or 'Page' }}</td>
                                <td class="cell-url">{{ row.url or '—' }}</td>
                                <td class="cell-right">{{ row.state_count }}</td>
                                <td class="cell-url">{{ row.state_ids_short|join(', ') }}</td>
                                <td class="cell-right" style="color: var(--accent-green);">{{ row.interactive_elements }}</td>
                                <td class="cell-right" style="color: var(--accent-amber);">{{ row.non_interactive_elements }}</td>
                                <td class="cell-right">{{ row.total_elements }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}

            <div class="elements-type-grid">
                <div class="data-table-wrap">
                    <div class="elements-subtitle-small">Top Interactive Types</div>
                    <div class="table-scroll">
                        <table class="data-table">
                            <caption class="sr-only">Top interactive element types</caption>
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th class="right">Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in element_inventory.top_interactive_types %}
                                <tr>
                                    <td class="cell-dim">{{ row.element_type }}</td>
                                    <td class="cell-right">{{ row.count }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="data-table-wrap">
                    <div class="elements-subtitle-small">Top Content Types</div>
                    <div class="table-scroll">
                        <table class="data-table">
                            <caption class="sr-only">Top content element types</caption>
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th class="right">Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in element_inventory.top_non_interactive_types %}
                                <tr>
                                    <td class="cell-dim">{{ row.element_type }}</td>
                                    <td class="cell-right">{{ row.count }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="untested-callout">
                <span class="callout-icon">&#9432;</span>
                <span>No element inventory available for this run.</span>
            </div>
            {% endif %}
        </section>

        <!-- ============================================================
             SECTION E: COVERAGE ANALYSIS
             ============================================================ -->
        {% if states|length >= 3 %}
        <section id="coverage-analysis" class="section section-collapsible collapsed animate-in delay-3" data-report-page="site-map">
            <div class="section-header" role="button" tabindex="0" aria-expanded="false" onclick="toggleSection(this.parentElement)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleSection(this.parentElement)}">
                <svg class="section-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                <h2>Coverage Analysis</h2>
                <div class="section-count">{{ states|length }} pages</div>
                <div class="section-line"></div>
            </div>
            <div class="section-body">
                <div class="coverage-table-wrap">
                    <div class="table-scroll">
                        <table class="data-table">
                            <caption class="sr-only">Page coverage analysis</caption>
                            <thead>
                                <tr>
                                    <th>Page</th>
                                    <th>URL</th>
                                    <th>Test Cases</th>
                                    <th class="right">Pass</th>
                                    <th class="right">Fail</th>
                                    <th class="right">Warn</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for page in page_coverage_map %}
                                <tr>
                                    <td>{{ page.title }}</td>
                                    <td class="cell-url">{{ page.url }}</td>
                                    <td class="cell-dim">{{ page.test_cases|length }}</td>
                                    <td class="cell-right" style="color: var(--accent-green);">{{ page.pass_count }}</td>
                                    <td class="cell-right" style="color: {% if page.fail_count %}var(--accent-red){% else %}var(--text-muted){% endif %};">{{ page.fail_count }}</td>
                                    <td class="cell-right" style="color: {% if page.warn_count %}var(--accent-amber){% else %}var(--text-muted){% endif %};">{{ page.warn_count }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {% set untested_count = coverage.interaction.total - coverage.interaction.executed %}
                {% if untested_count > 0 %}
                <div class="untested-callout">
                    <span class="callout-icon">&#9888;</span>
                    <span>{{ untested_count }} discovered interaction{{ 's' if untested_count != 1 }} were not exercised during this test run ({{ coverage.interaction.pct }}% interaction coverage).</span>
                </div>
                {% endif %}
            </div>
        </section>
        {% endif %}

        {% if mbt_coverage %}
        <section id="mbt-coverage" class="section section-collapsible collapsed animate-in delay-3" data-report-page="site-map">
            <div class="section-header" role="button" tabindex="0" aria-expanded="false" onclick="toggleSection(this.parentElement)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleSection(this.parentElement)}">
                <svg class="section-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                <h2>MBT Coverage Matrix</h2>
                <div class="section-count">{{ mbt_coverage.edge.covered }}/{{ mbt_coverage.edge.total }} edges</div>
                <div class="section-line"></div>
            </div>
            <div class="section-body">
                <div class="metric-cards" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
                    <div class="metric-card">
                        <div class="metric-label">State Coverage</div>
                        <div class="metric-value">{{ "%.0f"|format(mbt_coverage.state.pct) }}%</div>
                        <div class="metric-sub">{{ mbt_coverage.state.covered }}/{{ mbt_coverage.state.total }} states</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-label">Edge Coverage</div>
                        <div class="metric-value">{{ "%.0f"|format(mbt_coverage.edge.pct) }}%</div>
                        <div class="metric-sub">{{ mbt_coverage.edge.covered }}/{{ mbt_coverage.edge.total }} edges</div>
                    </div>
                    <div class="metric-card">
                        <div class="metric-label">Path Coverage</div>
                        <div class="metric-value">{{ "%.0f"|format(mbt_coverage.path.pct) }}%</div>
                        <div class="metric-sub">{{ mbt_coverage.path.covered }}/{{ mbt_coverage.path.total }} simple paths</div>
                    </div>
                </div>

                {% if mbt_coverage.actions and mbt_coverage.matrix_rows %}
                <div class="data-table-wrap" style="margin-top: 1rem;">
                    <div class="table-scroll">
                        <table class="data-table">
                            <caption class="sr-only">MBT page/action coverage matrix</caption>
                            <thead>
                                <tr>
                                    <th>Page Type</th>
                                    {% for action in mbt_coverage.actions %}
                                    <th class="right">{{ action|upper }}</th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in mbt_coverage.matrix_rows %}
                                <tr>
                                    <td>{{ row.page_name }}</td>
                                    {% for item in row.actions %}
                                    <td class="cell-right" style="color: {% if item.covered %}var(--accent-green){% else %}var(--accent-red){% endif %};">
                                        {{ 'Y' if item.covered else 'N' }}
                                    </td>
                                    {% endfor %}
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% endif %}

                {% if mbt_coverage.state.uncovered %}
                <div class="untested-callout" style="margin-top: 0.75rem;">
                    <span class="callout-icon">&#9888;</span>
                    <span>Uncovered states: {{ mbt_coverage.state.uncovered|join(', ') }}</span>
                </div>
                {% endif %}

                {% if mbt_coverage.edge.uncovered %}
                <div class="data-table-wrap" style="margin-top: 0.75rem;">
                    <div class="table-scroll">
                        <table class="data-table">
                            <caption class="sr-only">Uncovered navigation edges</caption>
                            <thead>
                                <tr>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Action</th>
                                    <th>Guards</th>
                                    <th>Inference</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for edge in mbt_coverage.edge.uncovered %}
                                <tr>
                                    <td>{{ edge.from_name }}</td>
                                    <td>{{ edge.to_name }}</td>
                                    <td class="cell-dim">{{ edge.action_type }}</td>
                                    <td class="cell-dim">{{ edge.guards|join(', ') if edge.guards else '-' }}</td>
                                    <td class="cell-dim">{{ edge.inferred_from or '-' }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% endif %}
            </div>
        </section>
        {% endif %}

        <!-- ============================================================
             SECTION E: EXPLORATION MODEL (graph + pages)
             ============================================================ -->
        <section class="section section-collapsible collapsed animate-in delay-3" id="exploration-model" data-report-page="site-map">
            <div class="section-header" role="button" tabindex="0" aria-expanded="false" onclick="toggleSection(this.parentElement)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleSection(this.parentElement)}">
                <svg class="section-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                <h2>Site Map</h2>
                <div class="section-count">{{ site_model_summary.total_page_types or 0 }} page types &middot; {{ site_model_summary.total_navigation_edges or 0 }} paths</div>
                <div class="section-line"></div>
            </div>
            <div class="section-body">
                <div class="filter-toolbar" role="toolbar" aria-label="Site map controls">
                    <label class="theme-picker" for="site-map-coverage-toggle" style="margin: 0;">
                        <span class="theme-picker-label">Coverage Overlay</span>
                        <input id="site-map-coverage-toggle" type="checkbox" onchange="toggleSiteMapCoverage(this.checked)">
                    </label>
                </div>
                <div id="graph-container"></div>
                <div class="graph-legend">
                    <div class="legend-item"><div class="legend-dot" style="color: var(--accent-cyan);"></div> node size = instance count</div>
                    <div class="legend-item"><div class="legend-dot" style="color: var(--accent-green);"></div> edge width = transition count</div>
                    <div class="legend-item"><div class="legend-dot" style="color: var(--accent-red);"></div> uncovered edge (overlay)</div>
                </div>

                <!-- Page type table -->
                <div class="data-table-wrap" style="margin-top: 1.5rem;">
                    <div class="table-scroll">
                        <table class="data-table">
                            <caption class="sr-only">Page types in site model</caption>
                            <thead>
                                <tr>
                                    <th>Page Type</th>
                                    <th>Archetype</th>
                                    <th>URL Pattern</th>
                                    <th class="right">Instances</th>
                                    <th class="right">Locator Quality</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for card in page_object_cards %}
                                <tr onclick="openPageObjectCard('{{ card.anchor_id }}')" style="cursor: pointer;">
                                    <td class="cell-action">{{ card.name }}</td>
                                    <td class="cell-dim">{{ card.archetype }}</td>
                                    <td class="cell-url">{{ card.url_pattern }}</td>
                                    <td class="cell-right">{{ card.instance_count }}</td>
                                    <td class="cell-right">{{ card.quality_score }}%</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <!-- ============================================================
             SECTION F: ALL ACTIONS (ADVANCED)
             ============================================================ -->
        <section id="execution-log" class="section section-collapsible collapsed animate-in delay-4" data-report-page="execution-log">
            <div class="section-header" role="button" tabindex="0" aria-expanded="false" onclick="toggleSection(this.parentElement)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleSection(this.parentElement)}">
                <svg class="section-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                <h2>All Actions (Advanced)</h2>
                <div class="section-count">{{ execution_rows|length }} total &middot; {{ orphan_execution_rows|length }} unmatched</div>
                <div class="section-line"></div>
            </div>
            <div class="section-body">
                {% if orphan_execution_rows %}
                <div class="untested-callout" style="margin-bottom: 0.75rem;">
                    <span class="callout-icon">&#9432;</span>
                    <span>{{ orphan_execution_rows|length }} action{{ 's' if orphan_execution_rows|length != 1 }} could not be mapped to a specific flow timeline.</span>
                </div>
                {% endif %}
                <div class="data-table-wrap">
                    <div class="table-scroll">
                        <table class="data-table">
                            <caption class="sr-only">All execution actions</caption>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Page</th>
                                    <th>Flow</th>
                                    <th>Step</th>
                                    <th>Expected</th>
                                    <th>Outcome</th>
                                    <th>Status</th>
                                    <th>To</th>
                                    <th>Confidence</th>
                                    <th>Reason</th>
                                    <th>Evidence</th>
                                    <th class="right">Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in execution_rows %}
                                {% set flow_ctx = execution_step_map.get(row.index) %}
                                <tr id="execution-step-{{ row.index }}" class="execution-log-row" onclick="openExecutionStepModal({{ row.index }})" title="Open detailed step view">
                                    <td class="cell-dim">{{ row.index }}</td>
                                    <td class="cell-action">{{ row.source_page }}</td>
                                    <td class="cell-action">
                                        {% if flow_ctx %}
                                        {{ flow_ctx.flow_name }} &middot; step {{ flow_ctx.flow_step }}
                                        {% else %}
                                        <span class="cell-dim">unmapped</span>
                                        {% endif %}
                                    </td>
                                    <td class="cell-action">{{ row.action_label }}</td>
                                    <td class="cell-dim" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ row.expected or '' }}</td>
                                    <td><span class="outcome {{ row.outcome }}">{{ row.outcome }}</span></td>
                                    <td>{% if row.verdict %}<span class="verdict {{ row.verdict }}">{{ row.verdict }}</span>{% endif %}</td>
                                    <td class="cell-action">{{ row.target_page }}</td>
                                    <td class="confidence-cell">{{ row.confidence_pct }}%</td>
                                    <td class="cell-dim confidence-reason">{{ row.confidence_reason or '—' }}</td>
                                    <td onclick="event.stopPropagation()">
                                        {% if row.screenshot_link %}
                                        <div class="evidence-cell">
                                            <a class="evidence-thumb-link" href="{{ row.screenshot_link }}" target="_blank" rel="noopener noreferrer">
                                                <img class="evidence-thumb" src="{{ row.screenshot_link }}" alt="evidence step {{ row.index }}" loading="lazy">
                                            </a>
                                            <a class="evidence-open-link" href="{{ row.screenshot_link }}" target="_blank" rel="noopener noreferrer">open</a>
                                        </div>
                                        {% else %}
                                        <span class="cell-dim">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="cell-right">{{ row.duration_ms }}ms</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <div id="execution-modal" class="execution-modal" onclick="closeExecutionStepModal(event)">
            <div class="execution-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="execution-modal-title">
                <div class="execution-modal-header">
                    <h3 id="execution-modal-title">Execution Step</h3>
                    <button class="execution-modal-close" onclick="closeExecutionStepModal()">Close</button>
                </div>
                <div id="execution-modal-body" class="execution-modal-body"></div>
            </div>
        </div>

        <div id="elements-modal" class="execution-modal" onclick="closeElementsModal(event)">
            <div class="execution-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="elements-modal-title">
                <div class="execution-modal-header">
                    <h3 id="elements-modal-title">Element Details</h3>
                    <button class="execution-modal-close" onclick="closeElementsModal()">Close</button>
                </div>
                <div id="elements-modal-body" class="execution-modal-body"></div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="report-container" role="contentinfo">
        <div class="report-footer">
            generated by <span>flowscout</span> v{{ version }}
        </div>
    </footer>

    <!-- ============================================================
         VIS.JS (deferred — loaded but graph not initialized until section expands)
         ============================================================ -->
    <script>{{ vis_network_js|safe }}</script>

    <!-- ============================================================
         SCRIPTS
         ============================================================ -->
    <script>
        /* --- Graph data (used by lazy init) --- */
        const graphData = {{ graph_json|tojson }};
        const executionRows = {{ execution_rows_json|tojson }};
        const executionStepMap = {{ execution_step_map|tojson }};
        const elementDrilldownMap = {{ element_drilldown_map|tojson }};
        const turboThemeStorageKey = 'flowscout-report-theme';
        const turboThemeDefault = 'catppuccin-mocha';
        const turboThemeBaseUrl = 'https://unpkg.com/@lgtm-hq/turbo-themes@0.19.2/packages/css/dist/themes/';
        let graphInitialized = false;
        let siteMapNetwork = null;
        let siteMapEdges = null;

        function availableTurboThemes() {
            return Array.from(document.querySelectorAll('#theme-picker-select option')).map((opt) => opt.value);
        }

        function isValidTurboTheme(themeId) {
            return availableTurboThemes().includes(themeId);
        }

        function applyTurboTheme(themeId, persist = true) {
            const chosen = isValidTurboTheme(themeId) ? themeId : turboThemeDefault;
            document.documentElement.setAttribute('data-theme', chosen);
            const link = document.getElementById('turbo-theme-stylesheet');
            if (link) {
                link.setAttribute('href', turboThemeBaseUrl + chosen + '.css');
            }
            if (persist) {
                try {
                    window.localStorage.setItem(turboThemeStorageKey, chosen);
                } catch (_err) {}
            }
            return chosen;
        }

        /* --- Lazy graph init on first expand of Site Map section --- */
        function initGraph() {
            if (graphInitialized) return;
            graphInitialized = true;

            const archetypeColors = {
                listing: '#38bdf8',
                detail: '#22c55e',
                form: '#f59e0b',
                search_results: '#a78bfa',
                landing: '#06b6d4',
                error: '#ef4444',
                unknown: '#64748b',
            };

            const nodes = new vis.DataSet(graphData.nodes.map((node) => ({
                id: node.id,
                label: String(node.label || node.id || 'Page').substring(0, 36),
                title:
                    '<div style="font-family:monospace;font-size:11px;padding:6px 10px;line-height:1.6;max-width:340px;">' +
                    'Page Type: ' + node.label + '<br>' +
                    'Archetype: ' + String(node.archetype || 'unknown').toUpperCase() + '<br>' +
                    'Instances: ' + String(node.instance_count || 0) + '<br>' +
                    'Locator Quality: ' + String(node.quality_score || 0) + '%<br>' +
                    'Pattern: ' + String(node.url_pattern || '-') +
                    '</div>',
                shape: 'dot',
                size: 16 + Math.min(Number(node.instance_count || 0), 10) * 2.5,
                color: {
                    background: '#101827',
                    border: archetypeColors[String(node.archetype || 'unknown')] || archetypeColors.unknown,
                    highlight: {
                        background: '#1f2937',
                        border: '#06b6d4',
                    },
                    hover: {
                        background: '#111827',
                        border: archetypeColors[String(node.archetype || 'unknown')] || archetypeColors.unknown,
                    },
                },
                font: {
                    color: '#dbe4f2',
                    size: 11,
                    face: "'JetBrains Mono', monospace",
                },
                borderWidth: 2,
                borderWidthSelected: 3,
                anchor_id: node.anchor_id || '',
            })));

            siteMapEdges = new vis.DataSet(graphData.edges.map((edge, index) => ({
                id: index,
                from: edge.source,
                to: edge.target,
                label: (edge.action_label || edge.action_type || 'transition') + ' (' + String(edge.occurrence_count || 0) + ')',
                title:
                    '<div style="font-family:monospace;font-size:11px;padding:6px 10px;line-height:1.6;max-width:320px;">' +
                    'Action: ' + String(edge.action_label || edge.action_type || 'transition') + '<br>' +
                    'Count: ' + String(edge.occurrence_count || 0) + '<br>' +
                    'Outcome: ' + String(edge.outcome || 'unknown') + '<br>' +
                    'Uncovered: ' + (edge.uncovered ? 'yes' : 'no') +
                    '</div>',
                arrows: { to: { enabled: true, scaleFactor: 0.65, type: 'arrow' } },
                smooth: { type: 'curvedCW', roundness: 0.2 },
                font: {
                    color: '#94a3b8',
                    size: 9,
                    strokeWidth: 0,
                    face: "'JetBrains Mono', monospace",
                    align: 'top',
                },
                width: 1.4 + Math.min(Number(edge.occurrence_count || 0), 8) * 0.45,
                hoverWidth: 1.2,
                color: {
                    color: '#16a34a',
                    highlight: '#22d3ee',
                    hover: '#22d3ee',
                    opacity: 0.8,
                },
                dashes: false,
                uncovered: Boolean(edge.uncovered),
                flow_id: edge.flow_id || '',
                template_id: edge.template_id || '',
            })));

            const container = document.getElementById('graph-container');
            siteMapNetwork = new vis.Network(container, { nodes, edges: siteMapEdges }, {
                physics: {
                    solver: 'forceAtlas2Based',
                    forceAtlas2Based: {
                        gravitationalConstant: -50,
                        centralGravity: 0.008,
                        springLength: 180,
                        springConstant: 0.04,
                        damping: 0.4,
                        avoidOverlap: 0.5,
                    },
                    stabilization: { iterations: 200, fit: true },
                },
                interaction: {
                    hover: true,
                    tooltipDelay: 150,
                    zoomView: true,
                    dragView: true,
                },
                layout: { improvedLayout: true },
            });

            siteMapNetwork.once('stabilizationIterationsDone', () => {
                siteMapNetwork.fit({ animation: { duration: 400, easingFunction: 'easeInOutQuad' } });
            });

            siteMapNetwork.on('click', (params) => {
                if (params.nodes && params.nodes.length) {
                    const node = nodes.get(params.nodes[0]);
                    if (node && node.anchor_id) {
                        openPageObjectCard(node.anchor_id);
                    }
                    return;
                }
                if (params.edges && params.edges.length) {
                    const edge = siteMapEdges.get(params.edges[0]);
                    if (edge && edge.flow_id) {
                        openFlowFromSiteMap(edge.flow_id, edge.template_id || '');
                    }
                }
            });

            const toggle = document.getElementById('site-map-coverage-toggle');
            toggleSiteMapCoverage(Boolean(toggle && toggle.checked));
        }

        function toggleSiteMapCoverage(enabled) {
            if (!siteMapEdges) return;
            siteMapEdges.forEach((edge) => {
                const isUncovered = Boolean(edge.uncovered);
                siteMapEdges.update({
                    id: edge.id,
                    color: isUncovered && enabled
                        ? { color: '#ef4444', highlight: '#f87171', hover: '#f87171', opacity: 0.92 }
                        : { color: '#16a34a', highlight: '#22d3ee', hover: '#22d3ee', opacity: 0.8 },
                    dashes: Boolean(isUncovered && enabled),
                });
            });
        }

        function openFlowFromSiteMap(flowId, templateId = '') {
            setReportPage('test-flows');
            if (templateId) {
                const templateCard = document.querySelector('.flow-template-card[data-template-id="' + templateId + '"]');
                if (templateCard) {
                    if (templateCard.classList.contains('collapsed')) {
                        templateCard.classList.remove('collapsed');
                    }
                    templateCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
            if (!flowId) return;
            expandTestCase(flowId);
        }

        function setReportPage(page, btnEl = null) {
            document.querySelectorAll('[data-report-page]').forEach((el) => {
                el.classList.toggle('page-hidden', el.dataset.reportPage !== page);
            });

            document.querySelectorAll('.page-btn').forEach((btn) => {
                btn.classList.remove('active');
            });
            if (!btnEl) {
                btnEl = document.querySelector('.page-btn[data-page="' + page + '"]');
            }
            if (btnEl) {
                btnEl.classList.add('active');
            }

            if (page === 'quality') {
                const diagnostics = document.getElementById('diagnostics-section');
                if (diagnostics && diagnostics.classList.contains('collapsed')) {
                    diagnostics.classList.remove('collapsed');
                    const header = diagnostics.querySelector('.section-header');
                    if (header) header.setAttribute('aria-expanded', 'true');
                }
            }

            if (page === 'site-map') {
                const model = document.getElementById('exploration-model');
                if (model && model.classList.contains('collapsed')) {
                    model.classList.remove('collapsed');
                    const header = model.querySelector('.section-header');
                    if (header) header.setAttribute('aria-expanded', 'true');
                }
                initGraph();
            }

            if (page === 'execution-log') {
                const log = document.getElementById('execution-log');
                if (log && log.classList.contains('collapsed')) {
                    log.classList.remove('collapsed');
                    const header = log.querySelector('.section-header');
                    if (header) header.setAttribute('aria-expanded', 'true');
                }
            }
        }

        function togglePomCode(anchorId, language, btnEl) {
            const card = document.getElementById('page-object-' + anchorId);
            if (!card) return;
            card.querySelectorAll('.pom-code-block').forEach((block) => {
                block.classList.toggle('active', block.dataset.lang === language);
            });
            card.querySelectorAll('.pom-lang-btn').forEach((button) => {
                button.classList.toggle('active', button === btnEl);
            });
        }

        function openPageObjectCard(anchorId) {
            setReportPage('page-objects');
            const card = document.getElementById('page-object-' + anchorId);
            if (!card) return;
            const details = card.querySelector('details');
            if (details) details.open = true;
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        /* --- Toggle collapsible section --- */
        function toggleSection(sectionEl) {
            sectionEl.classList.toggle('collapsed');
            const header = sectionEl.querySelector('.section-header');
            if (header) {
                header.setAttribute('aria-expanded', String(!sectionEl.classList.contains('collapsed')));
            }
            /* Lazy-init graph when Exploration Model is first expanded */
            if (sectionEl.id === 'exploration-model' && !sectionEl.classList.contains('collapsed')) {
                initGraph();
            }
        }

        /* --- Toggle test suite --- */
        function toggleSuite(headerEl) {
            headerEl.parentElement.classList.toggle('collapsed');
            const isExpanded = !headerEl.parentElement.classList.contains('collapsed');
            headerEl.setAttribute('aria-expanded', String(isExpanded));
        }

        /* --- Filter test cases by verdict --- */
        function filterTestCases(verdict, btnEl) {
            const suitesRoot = document.getElementById('test-suites');
            if (!suitesRoot) return;

            suitesRoot.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active', 'active-fail', 'active-warn'));
            if (!btnEl) {
                btnEl = suitesRoot.querySelector('.filter-toolbar .filter-btn[data-filter="' + verdict + '"]');
            }
            if (btnEl) {
                if (verdict === 'fail') btnEl.classList.add('active-fail');
                else if (verdict === 'warn') btnEl.classList.add('active-warn');
                else btnEl.classList.add('active');
            }
            filterFlowTemplates();
        }

        function jumpToTestCases(verdict) {
            setReportPage('test-flows');
            const section = document.getElementById('test-suites');
            filterTestCases(verdict, null);
            if (section) {
                section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        /* --- Search test cases --- */
        function searchTestCases(query) {
            const tagFilter = document.getElementById('template-tag-filter');
            if (tagFilter) {
                tagFilter.value = String(query || '');
            }
            filterFlowTemplates();
        }

        function filterFlowTemplates() {
            const suitesRoot = document.getElementById('test-suites');
            if (!suitesRoot) return;
            const activeBtn = suitesRoot.querySelector(
                '.filter-toolbar .filter-btn.active, .filter-toolbar .filter-btn.active-fail, .filter-toolbar .filter-btn.active-warn'
            );
            const verdict = activeBtn && activeBtn.dataset ? activeBtn.dataset.filter || 'all' : 'all';
            const typeFilter = (
                (document.getElementById('template-type-filter') || {}).value || ''
            ).toLowerCase().trim();
            const stabilityFilter = (
                (document.getElementById('template-stability-filter') || {}).value || 'all'
            ).toLowerCase().trim();
            const tagFilter = (
                (document.getElementById('template-tag-filter') || {}).value || ''
            ).toLowerCase().trim();

            suitesRoot.querySelectorAll('.flow-template-card').forEach((card) => {
                const stableCount = Number(card.dataset.stableCount || 0);
                const failCount = Number(card.dataset.failCount || 0);
                const warnCount = Number(card.dataset.warnCount || 0);
                const templateType = String(card.dataset.templateType || '').toLowerCase();
                const stability = String(card.dataset.stability || '').toLowerCase();
                const tags = String(card.dataset.tags || '').toLowerCase();
                const name = String(card.dataset.name || '').toLowerCase();

                const verdictMatch = (
                    verdict === 'all' ||
                    (verdict === 'fail' && failCount > 0) ||
                    (verdict === 'warn' && warnCount > 0) ||
                    (verdict === 'pass' && failCount === 0 && warnCount === 0 && stableCount > 0)
                );
                const typeMatch = !typeFilter || templateType.includes(typeFilter) || name.includes(typeFilter);
                const stabilityMatch = stabilityFilter === 'all' || stability === stabilityFilter;
                const tagMatch = !tagFilter || tags.includes(tagFilter);

                card.style.display = (verdictMatch && typeMatch && stabilityMatch && tagMatch) ? '' : 'none';
            });
        }

        /* --- Toggle state chain visibility --- */
        function toggleStateChain(btn) {
            const chain = btn.closest('.test-case-body').querySelector('.state-chain');
            if (chain) chain.classList.toggle('visible');
        }

        /* --- Expand specific test case from defects section --- */
        function expandTestCase(flowId) {
            setReportPage('test-flows');
            const el = document.querySelector('.test-case[data-flow-id="' + flowId + '"]');
            if (el) {
                const suite = el.closest('.test-suite');
                if (suite && suite.classList.contains('collapsed')) {
                    suite.classList.remove('collapsed');
                }
                el.open = true;
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            const row = document.querySelector('tr[data-flow-id="' + flowId + '"]');
            if (!row) return;
            const suite = row.closest('.test-suite');
            if (suite && suite.classList.contains('collapsed')) {
                suite.classList.remove('collapsed');
            }
            const details = row.closest('details');
            if (details) details.open = true;
            row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function openFlowInstance(flowId, rowEl) {
            if (rowEl) {
                const details = rowEl.closest('details');
                if (details) details.open = true;
            }
            expandTestCase(flowId);
        }

        function jumpToExecutionStep(stepIndex) {
            const mapped = executionStepMap[String(stepIndex)] || null;
            const rowId = mapped ? 'flow-step-' + stepIndex : 'execution-step-' + stepIndex;

            if (mapped && mapped.flow_id) {
                setReportPage('test-flows');
                const flowCase = document.querySelector('.test-case[data-flow-id="' + mapped.flow_id + '"]');
                if (flowCase) {
                    const suite = flowCase.closest('.test-suite');
                    if (suite && suite.classList.contains('collapsed')) {
                        suite.classList.remove('collapsed');
                    }
                    flowCase.open = true;
                } else {
                    const instanceRow = document.querySelector('tr[data-flow-id="' + mapped.flow_id + '"]');
                    if (instanceRow) {
                        const suite = instanceRow.closest('.test-suite');
                        if (suite && suite.classList.contains('collapsed')) {
                            suite.classList.remove('collapsed');
                        }
                        const details = instanceRow.closest('details');
                        if (details) details.open = true;
                    }
                }
            } else {
                setReportPage('execution-log');
                const section = document.getElementById('execution-log');
                if (section && section.classList.contains('collapsed')) {
                    section.classList.remove('collapsed');
                }
            }

            const row = document.getElementById(rowId);
            if (!row) return;
            document.querySelectorAll('.execution-row-highlight').forEach((el) => {
                el.classList.remove('execution-row-highlight');
            });
            row.classList.add('execution-row-highlight');
            row.scrollIntoView({ behavior: 'smooth', block: 'center' });
            openExecutionStepModal(stepIndex);
        }

        /* --- Focus trap for modals --- */
        let _lastFocusedElement = null;

        function _trapFocus(modalEl) {
            const focusable = modalEl.querySelectorAll(
                'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
            );
            if (focusable.length === 0) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            first.focus();

            modalEl._focusTrapHandler = function(e) {
                if (e.key !== 'Tab') return;
                if (e.shiftKey) {
                    if (document.activeElement === first) {
                        e.preventDefault();
                        last.focus();
                    }
                } else {
                    if (document.activeElement === last) {
                        e.preventDefault();
                        first.focus();
                    }
                }
            };
            modalEl.addEventListener('keydown', modalEl._focusTrapHandler);
        }

        function _releaseFocusTrap(modalEl) {
            if (modalEl._focusTrapHandler) {
                modalEl.removeEventListener('keydown', modalEl._focusTrapHandler);
                modalEl._focusTrapHandler = null;
            }
            if (_lastFocusedElement && _lastFocusedElement.focus) {
                _lastFocusedElement.focus();
                _lastFocusedElement = null;
            }
        }

        function closeExecutionStepModal(evt = null) {
            if (evt && evt.target && evt.currentTarget && evt.target !== evt.currentTarget) {
                return;
            }
            const modal = document.getElementById('execution-modal');
            if (!modal) return;
            modal.classList.remove('visible');
            document.body.style.overflow = '';
            _releaseFocusTrap(modal);
        }

        function closeElementsModal(evt = null) {
            if (evt && evt.target && evt.currentTarget && evt.target !== evt.currentTarget) {
                return;
            }
            const modal = document.getElementById('elements-modal');
            if (!modal) return;
            modal.classList.remove('visible');
            document.body.style.overflow = '';
            _releaseFocusTrap(modal);
        }

        function openElementsDrilldown(stateId, sourceLabel = 'Elements') {
            _lastFocusedElement = document.activeElement;
            const modal = document.getElementById('elements-modal');
            const title = document.getElementById('elements-modal-title');
            const body = document.getElementById('elements-modal-body');
            if (!modal || !title || !body) return;

            const info = elementDrilldownMap[String(stateId)] || null;
            const esc = (value) => String(value || '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
            const pretty = (value) => String(value || '')
                .replaceAll('_', ' ')
                .split(' ')
                .filter(Boolean)
                .map((token) => token.charAt(0).toUpperCase() + token.slice(1))
                .join(' ');

            if (!info) {
                title.textContent = 'Element Details';
                body.innerHTML = '<div class="execution-detail-text">No element details found for this row.</div>';
                modal.classList.add('visible');
                document.body.style.overflow = 'hidden';
                return;
            }

            title.textContent = 'Element Details · ' + (info.title || info.url || info.state_short || 'Page');

            const typeChips = (info.top_types || []).length
                ? info.top_types.map((item) => '<span class="elements-modal-chip">' + esc(pretty(item.name)) + ' (' + esc(item.count) + ')</span>').join('')
                : '<span class="cell-dim">No catalog types recorded.</span>';

            const zoneChips = (info.top_zones || []).length
                ? info.top_zones.map((item) => '<span class="elements-modal-chip">' + esc(pretty(item.name)) + ' (' + esc(item.count) + ')</span>').join('')
                : '<span class="cell-dim">No zones recorded.</span>';

            const entryRows = (info.entries || []).map((entry, idx) => {
                const kindClass = entry.is_interactive ? 'interactive' : 'content';
                const kindLabel = entry.is_interactive ? 'Interactive' : 'Content';
                const visibilityClass = entry.is_visible ? 'visible' : 'hidden';
                const visibilityLabel = entry.is_visible ? 'Visible' : 'Detected hidden';
                const domId = entry.dom_id || '—';
                const locator = entry.selector || '—';
                const typeLabel = pretty(entry.element_type || 'other');
                const zoneLabel = pretty(entry.zone_type || 'main_content');
                const label = entry.label || 'Unnamed element';
                const screenshotSource = entry.screenshot_source ? 'source: ' + pretty(entry.screenshot_source) : 'No screenshot';
                const screenshotCell = entry.screenshot_link
                    ? '<div class="evidence-cell">' +
                        '<a class="evidence-thumb-link" href="' + esc(entry.screenshot_link) + '" target="_blank" rel="noopener noreferrer" title="' + esc(screenshotSource) + '">' +
                            '<img class="evidence-thumb" src="' + esc(entry.screenshot_link) + '" alt="evidence for ' + esc(label) + '" loading="lazy">' +
                        '</a>' +
                        '<a class="evidence-open-link" href="' + esc(entry.screenshot_link) + '" target="_blank" rel="noopener noreferrer">open</a>' +
                    '</div>'
                    : '<span class="cell-dim">—</span>';
                return '<tr>' +
                    '<td class="cell-dim">' + esc(idx + 1) + '</td>' +
                    '<td class="cell-action">' + esc(label) + '</td>' +
                    '<td class="cell-dim">' +
                        '<span class="elements-entry-kind ' + esc(kindClass) + '">' + esc(kindLabel) + '</span>' +
                    '</td>' +
                    '<td class="cell-dim">' +
                        '<span class="elements-visibility ' + esc(visibilityClass) + '">' + esc(visibilityLabel) + '</span>' +
                    '</td>' +
                    '<td class="cell-dim">' + esc(typeLabel) + '</td>' +
                    '<td class="cell-dim">' + esc(zoneLabel) + '</td>' +
                    '<td class="cell-url">' + esc(domId) + '</td>' +
                    '<td class="cell-url">' + esc(locator) + '</td>' +
                    '<td>' + screenshotCell + '</td>' +
                '</tr>';
            }).join('');

            const entriesBlock = (info.entries || []).length
                ? '<div class="elements-modal-group">' +
                    '<div class="execution-detail-label">Catalog Entries (one per line)</div>' +
                    '<div class="table-scroll" style="max-height: 360px;">' +
                        '<table class="data-table">' +
                            '<thead>' +
                                '<tr>' +
                                    '<th>#</th>' +
                                    '<th>Element</th>' +
                                    '<th>Kind</th>' +
                                    '<th>Visibility</th>' +
                                    '<th>Type</th>' +
                                    '<th>Zone</th>' +
                                    '<th>DOM ID</th>' +
                                    '<th>Selector</th>' +
                                    '<th>Screenshot</th>' +
                                '</tr>' +
                            '</thead>' +
                            '<tbody>' + entryRows + '</tbody>' +
                        '</table>' +
                    '</div>' +
                    (info.entries_truncated ? '<div class="diag-subtext">Showing first 250 entries for readability.</div>' : '') +
                '</div>'
                : '<div class="execution-detail-text">No catalog entries are available for this state.</div>';

            body.innerHTML =
                '<div class="execution-detail-grid">' +
                    '<div class="execution-detail-card execution-detail-card--from"><div class="execution-detail-label">Page</div><div class="execution-detail-value">' + esc(info.title || 'Untitled page') + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--to"><div class="execution-detail-label">Source View</div><div class="execution-detail-value">' + esc(sourceLabel) + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--action"><div class="execution-detail-label">Interactive</div><div class="execution-detail-value">' + esc(info.interactive) + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--outcome"><div class="execution-detail-label">Content</div><div class="execution-detail-value">' + esc(info.non_interactive) + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--verdict"><div class="execution-detail-label">Total</div><div class="execution-detail-value">' + esc(info.total) + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--confidence"><div class="execution-detail-label">Depth</div><div class="execution-detail-value">' + esc(info.depth) + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--confidence"><div class="execution-detail-label">Visible</div><div class="execution-detail-value">' + esc(info.visible) + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--verdict"><div class="execution-detail-label">Detected Hidden</div><div class="execution-detail-value">' + esc(info.hidden) + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--step"><div class="execution-detail-label">Catalog Entries</div><div class="execution-detail-value">' + esc(info.catalog_entry_count) + '</div></div>' +
                '</div>' +
                '<div class="elements-modal-group">' +
                    '<div class="execution-detail-label">Top Element Types</div>' +
                    '<div class="elements-modal-list">' + typeChips + '</div>' +
                '</div>' +
                '<div class="elements-modal-group">' +
                    '<div class="execution-detail-label">Top Zones</div>' +
                    '<div class="elements-modal-list">' + zoneChips + '</div>' +
                '</div>' +
                entriesBlock +
                '<div class="execution-detail-text"><strong>URL:</strong><br>' + esc(info.url || '—') + '</div>' +
                '<div class="execution-detail-text"><strong>Technical Context:</strong><br>state_id: ' + esc(info.state_id || '—') + '</div>';

            modal.classList.add('visible');
            document.body.style.overflow = 'hidden';
            _trapFocus(modal);
        }

        function openExecutionStepModal(stepIndex) {
            _lastFocusedElement = document.activeElement;
            const modal = document.getElementById('execution-modal');
            const body = document.getElementById('execution-modal-body');
            if (!modal || !body) return;

            const row = executionRows.find((item) => item.index === stepIndex);
            if (!row) return;
            const flowContext = executionStepMap[String(row.index)] || null;

            const esc = (value) => String(value || '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

            const errors = (row.error_messages || []).map(esc).join('<br>');
            const consoleErrors = (row.console_errors || []).map(esc).join('<br>');
            const titleCaseToken = (value) => String(value || '')
                .replaceAll('_', ' ')
                .split(' ')
                .filter(Boolean)
                .map((token) => token.charAt(0).toUpperCase() + token.slice(1))
                .join(' ');
            const outcomeKey = String(row.outcome || '').toLowerCase();
            const verdictKey = String(row.verdict || '').toLowerCase();
            const outcomeBadge = outcomeKey
                ? '<span class="outcome ' + esc(outcomeKey) + '">' + esc(titleCaseToken(outcomeKey)) + '</span>'
                : '<span class="cell-dim">—</span>';
            const verdictBadge = verdictKey
                ? '<span class="verdict ' + esc(verdictKey) + '">' + esc(verdictKey) + '</span>'
                : '<span class="verdict inconclusive">n/a</span>';
            const evidenceHtml = row.screenshot_link
                ? '<a class="evidence-open-link" href="' + esc(row.screenshot_link) + '" target="_blank" rel="noopener noreferrer">Open evidence image in new tab</a>' +
                  '<div style="margin-top:0.5rem;"><img class="execution-detail-image" src="' + esc(row.screenshot_link) + '" alt="evidence step ' + row.index + '"></div>'
                : '<span class="cell-dim">No screenshot captured for this step.</span>';
            const inputSource = row.input_source
                ? esc(row.input_source) + (row.input_profile ? ' (' + esc(row.input_profile) + ')' : '')
                : 'n/a';
            const flowContextHtml = flowContext
                ? '<div class="execution-detail-card execution-detail-card--flow"><div class="execution-detail-label">Flow</div><div class="execution-detail-value">' + esc(flowContext.flow_name || flowContext.flow_id) + ' · step ' + esc(flowContext.flow_step) + '</div></div>'
                : '';

            body.innerHTML =
                '<div class="execution-detail-grid">' +
                    '<div class="execution-detail-card execution-detail-card--step"><div class="execution-detail-label">Step</div><div class="execution-detail-value">#' + row.index + '</div></div>' +
                    flowContextHtml +
                    '<div class="execution-detail-card execution-detail-card--action"><div class="execution-detail-label">Action</div><div class="execution-detail-value">' + esc(row.action_label) + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--outcome"><div class="execution-detail-label">Outcome</div><div class="execution-detail-value">' + outcomeBadge + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--verdict"><div class="execution-detail-label">Verdict</div><div class="execution-detail-value">' + verdictBadge + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--confidence"><div class="execution-detail-label">Confidence</div><div class="execution-detail-value">' + row.confidence_pct + '% · ' + esc(row.confidence_reason || '—') + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--input"><div class="execution-detail-label">Input Source</div><div class="execution-detail-value">' + inputSource + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--from"><div class="execution-detail-label">From</div><div class="execution-detail-value">' + esc(row.source_page) + '</div></div>' +
                    '<div class="execution-detail-card execution-detail-card--to"><div class="execution-detail-label">To</div><div class="execution-detail-value">' + esc(row.target_page) + '</div></div>' +
                '</div>' +
                '<div class="execution-focus-grid">' +
                    '<div class="execution-focus-card expected">' +
                        '<div class="execution-focus-header"><span class="step-tag expected">Expected</span></div>' +
                        '<div class="execution-focus-body">' + esc(row.expected || '—') + '</div>' +
                    '</div>' +
                    '<div class="execution-focus-card actual">' +
                        '<div class="execution-focus-header"><span class="step-tag actual">Actual</span></div>' +
                        '<div class="execution-focus-body">' + esc(row.actual || '—') + '</div>' +
                    '</div>' +
                    '<div class="execution-focus-card selector">' +
                        '<div class="execution-focus-header"><span class="step-tag selector">DOM ID</span></div>' +
                        '<div class="execution-focus-body">' + esc(row.dom_id || '—') + '</div>' +
                    '</div>' +
                    '<div class="execution-focus-card selector">' +
                        '<div class="execution-focus-header"><span class="step-tag selector">Selector</span></div>' +
                        '<div class="execution-focus-body">' + esc(row.target_selector || '—') + '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="execution-detail-text"><strong>URL:</strong><br>before: ' + esc(row.url_before || '—') + '<br>after: ' + esc(row.url_after || '—') + '</div>' +
                '<div class="execution-detail-text"><strong>Technical Details:</strong><br>action_id: ' + esc(row.action_id || '—') + '<br>dom_id: ' + esc(row.dom_id || '—') + '<br>source_state_id: ' + esc(row.source_state_id || '—') + '<br>target_state_id: ' + esc(row.target_state_id || '—') + '</div>' +
                (errors ? '<div class="execution-detail-text"><strong>Validation / Errors:</strong><br>' + errors + '</div>' : '') +
                (consoleErrors ? '<div class="execution-detail-text"><strong>Console Errors:</strong><br>' + consoleErrors + '</div>' : '') +
                (row.message ? '<div class="execution-detail-text"><strong>Message:</strong><br>' + esc(row.message) + '</div>' : '') +
                '<div class="execution-detail-text"><strong>Evidence:</strong><br>' + evidenceHtml + '</div>';

            modal.classList.add('visible');
            document.body.style.overflow = 'hidden';
            _trapFocus(modal);
        }

        document.addEventListener('DOMContentLoaded', () => {
            let savedTheme = turboThemeDefault;
            try {
                savedTheme = window.localStorage.getItem(turboThemeStorageKey) || turboThemeDefault;
            } catch (_err) {}
            const activeTheme = applyTurboTheme(savedTheme, false);

            const themeSelect = document.getElementById('theme-picker-select');
            if (themeSelect) {
                themeSelect.value = activeTheme;
                themeSelect.addEventListener('change', (event) => {
                    const selected = event.target && event.target.value ? event.target.value : turboThemeDefault;
                    const normalized = applyTurboTheme(selected, true);
                    if (themeSelect.value !== normalized) {
                        themeSelect.value = normalized;
                    }
                });
            }
            setReportPage('dashboard');
            filterFlowTemplates();
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closeExecutionStepModal();
                closeElementsModal();
            }
        });
    </script>

</body>
</html>
