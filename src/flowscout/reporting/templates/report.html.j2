<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>flowscout — Test Report — {{ start_url }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #06080c;
            --bg-base: #0a0f18;
            --bg-surface: #0f1620;
            --bg-raised: #141e2b;
            --bg-overlay: #1a2636;
            --border-dim: #1c2940;
            --border-base: #243352;
            --border-bright: #2d4a73;
            --text-primary: #c8d6e5;
            --text-secondary: #7a8fa6;
            --text-muted: #4a5f78;
            --accent-green: #00e59b;
            --accent-green-dim: #00e59b33;
            --accent-green-glow: #00e59b18;
            --accent-amber: #ffbe0b;
            --accent-amber-dim: #ffbe0b33;
            --accent-red: #ff4757;
            --accent-red-dim: #ff475733;
            --accent-blue: #4facfe;
            --accent-blue-dim: #4facfe33;
            --accent-cyan: #00f5d4;
            --accent-cyan-dim: #00f5d420;
            --accent-purple: #a78bfa;
            --accent-purple-dim: rgba(167, 139, 250, 0.15);
            --font-mono: 'JetBrains Mono', 'SF Mono', 'Cascadia Code', monospace;
            --font-body: 'DM Sans', 'SF Pro Display', -apple-system, sans-serif;
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: var(--font-body);
            background: var(--bg-deep);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* === Atmospheric background === */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 50% at 20% 0%, #00e59b06 0%, transparent 60%),
                radial-gradient(ellipse 60% 40% at 80% 100%, #4facfe05 0%, transparent 60%),
                radial-gradient(ellipse 100% 100% at 50% 50%, #0a0f18 0%, #06080c 100%);
            pointer-events: none;
            z-index: -1;
        }

        /* === Scanline texture === */
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background: repeating-linear-gradient(
                0deg,
                transparent,
                transparent 2px,
                #00000008 2px,
                #00000008 4px
            );
            pointer-events: none;
            z-index: 1000;
            mix-blend-mode: multiply;
        }

        /* === Typography === */
        .font-mono { font-family: var(--font-mono); }

        /* === Layout === */
        .report-container { max-width: 1440px; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 3rem); }

        /* === Header === */
        .report-header {
            position: sticky;
            top: 0;
            z-index: 50;
            border-bottom: 1px solid var(--border-dim);
            background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-deep)ee 100%);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
        }

        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 0;
            gap: 2rem;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .brand-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--accent-green) 0%, var(--accent-cyan) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 20px var(--accent-green-dim), inset 0 1px 0 #ffffff20;
        }

        .brand-icon svg { width: 18px; height: 18px; }

        .brand-text {
            font-family: var(--font-mono);
            font-weight: 600;
            font-size: 1.125rem;
            letter-spacing: -0.02em;
            background: linear-gradient(135deg, var(--accent-green) 0%, var(--accent-cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .brand-subtitle {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-muted);
            margin-left: 0.75rem;
            padding: 0.1875rem 0.5rem;
            border: 1px solid var(--border-dim);
            border-radius: 4px;
        }

        .header-meta {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .header-meta-item {
            display: flex;
            align-items: center;
            gap: 0.375rem;
        }

        .header-meta-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent-green);
            box-shadow: 0 0 8px var(--accent-green-dim);
            animation: pulse-dot 2s ease-in-out infinite;
        }

        @keyframes pulse-dot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        /* === Target URL banner === */
        .target-banner {
            margin-top: 2rem;
            padding: 1.25rem 1.5rem;
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 1rem;
            position: relative;
            overflow: hidden;
        }

        .target-banner::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(180deg, var(--accent-green) 0%, var(--accent-cyan) 100%);
            border-radius: 3px 0 0 3px;
        }

        .target-label {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--accent-green);
            opacity: 0.7;
        }

        .target-url {
            font-family: var(--font-mono);
            font-size: 0.9375rem;
            font-weight: 400;
            color: var(--text-primary);
            letter-spacing: -0.01em;
        }

        /* ============================================================
           DASHBOARD
           ============================================================ */
        .dashboard {
            margin-top: 2rem;
            display: grid;
            grid-template-columns: 200px 1fr;
            gap: 1.5rem;
            align-items: start;
        }

        /* --- Pass rate donut --- */
        .pass-rate-ring {
            position: relative;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            justify-self: center;
        }

        .pass-rate-ring-inner {
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: var(--bg-deep);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1;
        }

        .pass-rate-pct {
            font-family: var(--font-mono);
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.04em;
            color: var(--accent-green);
            line-height: 1;
        }

        .pass-rate-label {
            font-family: var(--font-mono);
            font-size: 0.5625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        /* --- Dashboard right panel --- */
        .dashboard-right {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        /* --- Metric cards row --- */
        .metric-cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1px;
            background: var(--border-dim);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-dim);
        }

        .metric-card {
            background: var(--bg-surface);
            padding: 1rem 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            transition: background 0.2s ease;
        }

        .metric-card:hover { background: var(--bg-raised); }

        .metric-value {
            font-family: var(--font-mono);
            font-size: 1.75rem;
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1;
            color: var(--text-primary);
        }

        .metric-value.green { color: var(--accent-green); }
        .metric-value.amber { color: var(--accent-amber); }
        .metric-value.red { color: var(--accent-red); }
        .metric-value.blue { color: var(--accent-blue); }
        .metric-value.cyan { color: var(--accent-cyan); }

        .metric-label {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
        }

        .metric-breakdown {
            display: flex;
            gap: 0.375rem;
            margin-top: 0.375rem;
        }

        .metric-breakdown-bar {
            height: 3px;
            border-radius: 2px;
            transition: width 0.6s ease;
        }

        /* --- Coverage bars --- */
        .coverage-bars {
            display: flex;
            flex-direction: column;
            gap: 0.625rem;
            padding: 1rem 1.25rem;
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
        }

        .coverage-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .coverage-label {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
            width: 140px;
            flex-shrink: 0;
        }

        .coverage-track {
            flex: 1;
            height: 6px;
            background: var(--bg-overlay);
            border-radius: 3px;
            overflow: hidden;
        }

        .coverage-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.6s ease;
        }

        .coverage-fill.green { background: var(--accent-green); }
        .coverage-fill.blue { background: var(--accent-blue); }
        .coverage-fill.cyan { background: var(--accent-cyan); }

        .coverage-pct {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 600;
            color: var(--text-secondary);
            width: 60px;
            text-align: right;
            flex-shrink: 0;
        }

        /* ============================================================
           SECTIONS
           ============================================================ */
        .section {
            margin-top: 3rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }

        .section-header h2 {
            font-family: var(--font-body);
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text-primary);
            letter-spacing: -0.01em;
        }

        .section-count {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 500;
            color: var(--text-muted);
            background: var(--bg-raised);
            border: 1px solid var(--border-dim);
            padding: 0.125rem 0.5rem;
            border-radius: 100px;
        }

        .section-line {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, var(--border-dim) 0%, transparent 100%);
        }

        /* --- Collapsible sections --- */
        .section-collapsible .section-header {
            cursor: pointer;
            user-select: none;
            padding: 0.5rem 0;
            border-radius: 8px;
            transition: opacity 0.15s ease;
        }

        .section-collapsible .section-header:hover { opacity: 0.85; }

        .section-toggle-icon {
            width: 16px;
            height: 16px;
            color: var(--text-muted);
            transition: transform 0.25s ease;
            flex-shrink: 0;
        }

        .section-collapsible.collapsed .section-toggle-icon { transform: rotate(-90deg); }
        .section-collapsible.collapsed .section-body { display: none; }

        /* ============================================================
           TEST SUITES (primary view)
           ============================================================ */

        /* --- Filter toolbar --- */
        .filter-toolbar {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter-btn {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 500;
            color: var(--text-muted);
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            padding: 0.375rem 0.75rem;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .filter-btn:hover { border-color: var(--border-base); color: var(--text-secondary); }
        .filter-btn.active { color: var(--accent-green); border-color: var(--accent-green); background: var(--accent-green-dim); }
        .filter-btn.active-fail { color: var(--accent-red); border-color: var(--accent-red); background: var(--accent-red-dim); }
        .filter-btn.active-warn { color: var(--accent-amber); border-color: var(--accent-amber); background: var(--accent-amber-dim); }

        .search-box {
            margin-left: auto;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-primary);
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            padding: 0.375rem 0.75rem;
            border-radius: 6px;
            outline: none;
            width: 220px;
            transition: border-color 0.15s ease;
        }

        .search-box::placeholder { color: var(--text-muted); }
        .search-box:focus { border-color: var(--accent-cyan-dim); }

        /* --- Test suite (group) --- */
        .test-suite { margin-bottom: 1rem; }

        .suite-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            cursor: pointer;
            margin-bottom: 0.5rem;
            transition: background 0.15s ease;
        }

        .suite-header:hover { background: var(--bg-raised); }

        .suite-chevron {
            width: 14px; height: 14px;
            color: var(--text-muted);
            transition: transform 0.2s ease;
            flex-shrink: 0;
        }

        .test-suite.collapsed .suite-chevron { transform: rotate(-90deg); }
        .test-suite.collapsed .suite-body { display: none; }

        .suite-name {
            font-weight: 600;
            font-size: 0.875rem;
        }

        .suite-meta {
            display: flex;
            gap: 0.5rem;
            margin-left: auto;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            align-items: center;
        }

        .suite-stat {
            padding: 0.125rem 0.5rem;
            border-radius: 4px;
            font-weight: 600;
        }

        .suite-stat.pass { color: var(--accent-green); background: var(--accent-green-dim); }
        .suite-stat.fail { color: var(--accent-red); background: var(--accent-red-dim); }
        .suite-stat.warn { color: var(--accent-amber); background: var(--accent-amber-dim); }

        .suite-pass-bar {
            width: 60px;
            height: 4px;
            background: var(--bg-overlay);
            border-radius: 2px;
            overflow: hidden;
        }

        .suite-pass-fill {
            height: 100%;
            background: var(--accent-green);
            border-radius: 2px;
            transition: width 0.4s ease;
        }

        .suite-body {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        /* --- Test case card --- */
        .test-case {
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            overflow: hidden;
            transition: border-color 0.2s ease;
        }

        .test-case:hover { border-color: var(--border-base); }

        .test-case-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.875rem 1.25rem;
            cursor: pointer;
            user-select: none;
            transition: background 0.15s ease;
            list-style: none;
        }

        .test-case-header::-webkit-details-marker { display: none; }
        .test-case-header::marker { display: none; content: ''; }
        .test-case-header:hover { background: var(--bg-raised); }

        .test-case-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 0;
        }

        .test-case-right {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-shrink: 0;
        }

        .tc-chevron {
            width: 16px;
            height: 16px;
            color: var(--text-muted);
            transition: transform 0.2s ease;
            flex-shrink: 0;
        }

        details[open] .tc-chevron { transform: rotate(180deg); }

        .tc-name {
            font-weight: 500;
            font-size: 0.875rem;
            color: var(--text-primary);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tc-steps-count {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-muted);
            white-space: nowrap;
        }

        /* --- Verdict badge --- */
        .verdict {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 0.1875rem 0.5rem;
            border-radius: 4px;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .verdict.pass {
            color: var(--accent-green);
            background: var(--accent-green-dim);
        }
        .verdict.fail {
            color: var(--accent-red);
            background: var(--accent-red-dim);
        }
        .verdict.warn {
            color: var(--accent-amber);
            background: var(--accent-amber-dim);
        }
        .verdict.inconclusive {
            color: var(--text-muted);
            background: #4a5f7815;
        }

        /* --- Flow type badge --- */
        .type-badge {
            font-family: var(--font-mono);
            font-size: 0.5625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 0.1875rem 0.5rem;
            border-radius: 4px;
            flex-shrink: 0;
        }

        .type-badge.linear {
            color: var(--accent-blue);
            background: var(--accent-blue-dim);
        }

        .type-badge.cycle {
            color: var(--accent-amber);
            background: var(--accent-amber-dim);
        }

        /* --- Tags --- */
        .tc-tags { display: flex; gap: 0.25rem; flex-shrink: 0; }
        .tc-tag {
            font-family: var(--font-mono);
            font-size: 0.5625rem;
            font-weight: 500;
            padding: 0.125rem 0.375rem;
            border-radius: 3px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .tc-tag.navigation { color: var(--accent-green); background: var(--accent-green-dim); }
        .tc-tag.search { color: var(--accent-cyan); background: var(--accent-cyan-dim); }
        .tc-tag.form { color: var(--accent-amber); background: var(--accent-amber-dim); }
        .tc-tag.dropdown { color: var(--accent-purple); background: var(--accent-purple-dim); }
        .tc-tag.interaction { color: var(--text-muted); background: #4a5f7815; }

        /* --- Test case body --- */
        .test-case-body {
            padding: 0 1.25rem 1.25rem;
            border-top: 1px solid var(--border-dim);
        }

        /* --- Precondition --- */
        .precondition {
            margin-top: 1rem;
            padding: 0.625rem 1rem;
            background: var(--bg-raised);
            border-left: 3px solid var(--accent-purple);
            border-radius: 0 6px 6px 0;
            font-size: 0.8125rem;
            color: var(--accent-purple);
            font-style: italic;
        }

        /* --- Step timeline --- */
        .step-timeline {
            margin-top: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .step-item {
            display: grid;
            grid-template-columns: 32px 1fr;
            gap: 0 0.75rem;
            padding: 0.75rem 0;
            position: relative;
        }

        .step-item:not(:last-child)::after {
            content: '';
            position: absolute;
            left: 15px;
            top: 44px;
            bottom: 0;
            width: 2px;
            background: var(--border-dim);
        }

        .step-item.pass:not(:last-child)::after { background: var(--accent-green-dim); }
        .step-item.fail:not(:last-child)::after { background: var(--accent-red-dim); }
        .step-item.warn:not(:last-child)::after { background: var(--accent-amber-dim); }

        .step-number {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 700;
            border: 2px solid var(--border-base);
            background: var(--bg-surface);
            color: var(--text-muted);
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        .step-item.pass .step-number { border-color: var(--accent-green); color: var(--accent-green); }
        .step-item.fail .step-number { border-color: var(--accent-red); color: var(--accent-red); }
        .step-item.warn .step-number { border-color: var(--accent-amber); color: var(--accent-amber); }

        .step-content { min-width: 0; }

        .step-action-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .step-action-text {
            font-size: 0.8125rem;
            font-weight: 500;
            color: var(--text-primary);
        }

        .step-details {
            margin-top: 0.375rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .step-expected,
        .step-actual {
            font-size: 0.75rem;
            display: flex;
            align-items: baseline;
            gap: 0.4rem;
        }

        .step-tag {
            font-family: var(--font-mono);
            font-size: 0.5625rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            padding: 0.125rem 0.375rem;
            border-radius: 3px;
            flex-shrink: 0;
        }

        .step-tag.expected {
            color: var(--accent-purple);
            background: var(--accent-purple-dim);
            border: 1px solid rgba(167, 139, 250, 0.25);
        }

        .step-tag.actual {
            color: var(--accent-cyan);
            background: rgba(103, 232, 249, 0.10);
            border: 1px solid rgba(103, 232, 249, 0.20);
        }

        .step-expected .step-text { color: rgba(167, 139, 250, 0.7); }
        .step-actual .step-text { color: rgba(103, 232, 249, 0.7); }

        /* --- Selector expander --- */
        .step-selector-toggle {
            font-family: var(--font-mono);
            font-size: 0.5625rem;
            cursor: pointer;
            color: var(--text-muted);
            background: none;
            border: 1px solid var(--border-dim);
            padding: 0.125rem 0.375rem;
            border-radius: 3px;
            margin-top: 0.375rem;
            opacity: 0.6;
            transition: opacity 0.15s ease;
        }
        .step-selector-toggle:hover { opacity: 1; border-color: var(--border-base); }
        .step-selector-detail {
            display: none;
            margin-top: 0.25rem;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            color: var(--text-muted);
            background: var(--bg-raised);
            padding: 0.375rem 0.625rem;
            border-radius: 4px;
            word-break: break-all;
            border: 1px solid var(--border-dim);
        }
        .step-selector-detail.visible { display: block; }

        /* --- Conclusion --- */
        .conclusion {
            margin-top: 0.75rem;
            padding: 0.625rem 1rem;
            background: var(--bg-raised);
            border-radius: 6px;
            font-size: 0.8125rem;
            color: var(--text-secondary);
            font-style: italic;
        }

        /* --- BDD toggle --- */
        .gherkin-toggle {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            cursor: pointer;
            color: var(--accent-cyan);
            background: none;
            border: 1px solid var(--accent-cyan-dim);
            padding: 0.25rem 0.625rem;
            border-radius: 4px;
            margin-top: 0.75rem;
        }
        .gherkin-toggle:hover { background: var(--accent-cyan-dim); }
        .gherkin-block {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--accent-cyan);
            background: var(--bg-raised);
            padding: 0.75rem 1rem;
            border-radius: 6px;
            margin-top: 0.5rem;
            white-space: pre-wrap;
            display: none;
            border: 1px solid var(--accent-cyan-dim);
        }
        .gherkin-block.visible { display: block; }

        /* --- State chain (debug) --- */
        .state-chain-toggle {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            cursor: pointer;
            color: var(--text-muted);
            background: none;
            border: 1px solid var(--border-dim);
            padding: 0.1875rem 0.5rem;
            border-radius: 4px;
            margin-top: 0.5rem;
            margin-left: 0.5rem;
        }

        .state-chain-toggle:hover { border-color: var(--border-base); }

        .state-chain {
            display: none;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.375rem;
            margin-top: 0.5rem;
        }

        .state-chain.visible { display: flex; }

        .state-node {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 500;
            padding: 0.25rem 0.625rem;
            background: var(--bg-overlay);
            border: 1px solid var(--border-base);
            border-radius: 6px;
            color: var(--accent-cyan);
        }

        .state-arrow {
            color: var(--text-muted);
            font-size: 0.75rem;
        }

        /* ============================================================
           COVERAGE ANALYSIS
           ============================================================ */
        .coverage-table-wrap {
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
            overflow: hidden;
        }

        .untested-callout {
            margin-top: 1rem;
            padding: 0.875rem 1.25rem;
            background: var(--accent-amber-dim);
            border: 1px solid rgba(255, 190, 11, 0.2);
            border-radius: 8px;
            font-size: 0.8125rem;
            color: var(--accent-amber);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .untested-callout .callout-icon {
            font-size: 1rem;
            flex-shrink: 0;
        }

        /* ============================================================
           DEFECTS
           ============================================================ */
        .defect-card {
            background: linear-gradient(135deg, #ff475708, #ff475703);
            border: 1px solid #ff475725;
            border-radius: 10px;
            padding: 1rem 1.25rem;
            cursor: pointer;
            transition: border-color 0.15s ease;
        }

        .defect-card:hover { border-color: #ff475750; }

        .defect-card.warning {
            background: linear-gradient(135deg, #ffbe0b08, #ffbe0b03);
            border-color: #ffbe0b25;
        }

        .defect-card.warning:hover { border-color: #ffbe0b50; }

        .defect-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.375rem;
        }

        .defect-name {
            font-weight: 500;
            font-size: 0.875rem;
        }

        .defect-detail {
            font-size: 0.8125rem;
            color: var(--text-secondary);
        }

        /* ============================================================
           DIAGNOSTICS
           ============================================================ */
        .diagnostics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .diag-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 10px;
            padding: 0.875rem 1rem;
        }

        .diag-label {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            margin-bottom: 0.35rem;
        }

        .diag-value {
            font-family: var(--font-mono);
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .diag-value.warn { color: var(--accent-amber); }
        .diag-value.fail { color: var(--accent-red); }
        .diag-value.pass { color: var(--accent-green); }

        .diag-subtext {
            margin-top: 0.35rem;
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .diag-reason-list {
            margin-top: 0.55rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
        }

        .diag-chip {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            color: var(--text-secondary);
            border: 1px solid var(--border-dim);
            border-radius: 999px;
            padding: 0.2rem 0.5rem;
            background: var(--bg-overlay);
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ============================================================
           TABLES (shared)
           ============================================================ */
        .data-table-wrap {
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
            overflow: hidden;
        }

        .data-table {
            width: 100%;
            font-size: 0.8125rem;
            border-collapse: collapse;
        }

        .data-table thead th {
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            text-align: left;
            padding: 0.75rem 1.25rem;
            border-bottom: 1px solid var(--border-dim);
            background: var(--bg-raised);
            position: sticky;
            top: 0;
        }

        .data-table thead th.right { text-align: right; }

        .data-table tbody td {
            padding: 0.625rem 1.25rem;
            border-bottom: 1px solid #0f1620;
            vertical-align: middle;
        }

        .data-table tbody tr { transition: background 0.1s ease; }
        .data-table tbody tr:hover { background: var(--bg-raised); }
        .data-table tbody tr:last-child td { border-bottom: none; }

        .cell-id {
            font-family: var(--font-mono);
            font-weight: 500;
            font-size: 0.75rem;
            color: var(--accent-cyan);
        }

        .cell-url {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-muted);
            max-width: 340px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .cell-dim {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .cell-right {
            text-align: right;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .cell-action {
            font-size: 0.75rem;
            color: var(--text-secondary);
            max-width: 420px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .cell-signals {
            font-size: 0.6875rem;
            color: var(--text-muted);
            max-width: 250px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .table-scroll {
            overflow-x: auto;
            max-height: 480px;
            overflow-y: auto;
        }

        .confidence-cell {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-primary);
        }

        .confidence-reason {
            max-width: 260px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .evidence-cell {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .evidence-thumb-link {
            display: inline-flex;
            border: 1px solid var(--border-dim);
            border-radius: 6px;
            overflow: hidden;
            background: var(--bg-overlay);
        }

        .evidence-thumb {
            width: 40px;
            height: 28px;
            object-fit: cover;
            display: block;
        }

        .evidence-open-link {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--accent-cyan);
            text-decoration: none;
        }

        .evidence-open-link:hover { text-decoration: underline; }

        /* --- Outcome badges --- */
        .outcome {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 0.1875rem 0.5rem;
            border-radius: 4px;
            white-space: nowrap;
        }

        .outcome.navigation {
            color: var(--accent-green);
            background: var(--accent-green-dim);
        }
        .outcome.dom_change {
            color: var(--accent-amber);
            background: var(--accent-amber-dim);
        }
        .outcome.no_change {
            color: var(--text-muted);
            background: #4a5f7815;
        }
        .outcome.timeout,
        .outcome.validation_error,
        .outcome.network_error,
        .outcome.console_error,
        .outcome.exception {
            color: var(--accent-red);
            background: var(--accent-red-dim);
        }

        /* --- Graph --- */
        #graph-container {
            height: 400px;
            background: var(--bg-surface);
            border: 1px solid var(--border-dim);
            border-radius: 12px;
            position: relative;
            overflow: hidden;
        }

        #graph-container::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 50% 50%, var(--accent-green-glow) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        .graph-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 0.75rem;
            padding: 0 0.25rem;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-muted);
        }

        .legend-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            box-shadow: 0 0 6px currentColor;
        }

        /* ============================================================
           FOOTER
           ============================================================ */
        .report-footer {
            margin-top: 4rem;
            padding: 1.5rem 0;
            border-top: 1px solid var(--border-dim);
            text-align: center;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            color: var(--text-muted);
        }

        .report-footer span {
            background: linear-gradient(135deg, var(--accent-green), var(--accent-cyan));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 600;
        }

        /* ============================================================
           ANIMATIONS
           ============================================================ */
        @keyframes fade-up {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-in {
            animation: fade-up 0.5s ease forwards;
            opacity: 0;
        }

        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        /* === Scrollbar === */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border-base); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--border-bright); }

        /* === Responsive === */
        @media (max-width: 768px) {
            .header-meta { display: none; }
            .dashboard { grid-template-columns: 1fr; }
            .pass-rate-ring { width: 140px; height: 140px; }
            .pass-rate-ring-inner { width: 90px; height: 90px; }
            .pass-rate-pct { font-size: 1.5rem; }
            .metric-cards { grid-template-columns: repeat(2, 1fr); }
            .metric-value { font-size: 1.25rem; }
            .coverage-label { width: 100px; }
            .search-box { width: 100%; margin-left: 0; }
        }
    </style>
</head>
<body>

    <!-- ============================================================
         SECTION A: HEADER
         ============================================================ -->
    <header class="report-header">
        <div class="report-container">
            <div class="header-inner">
                <div class="brand">
                    <div class="brand-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#06080c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M12 2v4m0 12v4M2 12h4m12 0h4"/>
                            <path d="m4.93 4.93 2.83 2.83m8.48 8.48 2.83 2.83M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83"/>
                        </svg>
                    </div>
                    <div class="brand-text">flowscout</div>
                    <div class="brand-subtitle">Test Report</div>
                </div>
                <div class="header-meta">
                    <div class="header-meta-item">
                        <div class="header-meta-dot"></div>
                        <span>{{ started_at[:19] }} UTC</span>
                    </div>
                    <div class="header-meta-item">
                        <span>{{ "%.1f"|format(duration) }}s</span>
                    </div>
                    <div class="header-meta-item">
                        <span>{{ config_strategy }}</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="report-container">

        <!-- Target URL -->
        <div class="target-banner animate-in">
            <div>
                <div class="target-label">target</div>
                <div class="target-url">{{ start_url }}</div>
            </div>
        </div>

        <!-- ============================================================
             SECTION B: DASHBOARD
             ============================================================ -->
        {% set pass_pct = coverage.pass_rate.pct %}
        {% set fail_pct = (flow_counts.fail / [flows|length, 1]|max * 100)|round|int %}
        {% set warn_pct = (flow_counts.warn / [flows|length, 1]|max * 100)|round|int %}

        <div class="dashboard animate-in delay-1">
            <!-- Pass rate donut -->
            <div class="pass-rate-ring" style="background: conic-gradient(
                var(--accent-green) 0deg {{ (pass_pct * 3.6)|round|int }}deg,
                var(--accent-red) {{ (pass_pct * 3.6)|round|int }}deg {{ ((pass_pct + fail_pct) * 3.6)|round|int }}deg,
                var(--accent-amber) {{ ((pass_pct + fail_pct) * 3.6)|round|int }}deg {{ ((pass_pct + fail_pct + warn_pct) * 3.6)|round|int }}deg,
                var(--bg-overlay) {{ ((pass_pct + fail_pct + warn_pct) * 3.6)|round|int }}deg 360deg
            );">
                <div class="pass-rate-ring-inner">
                    <div class="pass-rate-pct">{{ pass_pct }}%</div>
                    <div class="pass-rate-label">Passed</div>
                </div>
            </div>

            <!-- Right panel: metric cards + coverage bars -->
            <div class="dashboard-right">
                <div class="metric-cards">
                    <!-- Test Cases -->
                    <div class="metric-card">
                        <div class="metric-value">{{ flows|length }}</div>
                        <div class="metric-label">Test Cases</div>
                        {% if flows|length > 0 %}
                        <div class="metric-breakdown">
                            {% if flow_counts.pass %}<div class="metric-breakdown-bar" style="width: {{ flow_counts.pass / flows|length * 100 }}%; background: var(--accent-green);"></div>{% endif %}
                            {% if flow_counts.fail %}<div class="metric-breakdown-bar" style="width: {{ flow_counts.fail / flows|length * 100 }}%; background: var(--accent-red);"></div>{% endif %}
                            {% if flow_counts.warn %}<div class="metric-breakdown-bar" style="width: {{ flow_counts.warn / flows|length * 100 }}%; background: var(--accent-amber);"></div>{% endif %}
                        </div>
                        {% endif %}
                    </div>

                    <!-- Test Steps -->
                    <div class="metric-card">
                        <div class="metric-value">{{ total_test_steps }}</div>
                        <div class="metric-label">Test Steps</div>
                        {% if total_test_steps > 0 %}
                        <div class="metric-breakdown">
                            {% if step_verdicts_summary.pass %}<div class="metric-breakdown-bar" style="width: {{ step_verdicts_summary.pass / total_test_steps * 100 }}%; background: var(--accent-green);"></div>{% endif %}
                            {% if step_verdicts_summary.fail %}<div class="metric-breakdown-bar" style="width: {{ step_verdicts_summary.fail / total_test_steps * 100 }}%; background: var(--accent-red);"></div>{% endif %}
                            {% if step_verdicts_summary.warn %}<div class="metric-breakdown-bar" style="width: {{ step_verdicts_summary.warn / total_test_steps * 100 }}%; background: var(--accent-amber);"></div>{% endif %}
                        </div>
                        {% endif %}
                    </div>

                    <!-- Pages Discovered -->
                    <div class="metric-card">
                        <div class="metric-value cyan">{{ states|length }}</div>
                        <div class="metric-label">Pages</div>
                    </div>

                    <!-- Duration -->
                    <div class="metric-card">
                        <div class="metric-value blue">{{ "%.1f"|format(duration) }}<span style="font-size: 0.75rem; font-weight: 400; color: var(--text-muted);">s</span></div>
                        <div class="metric-label">Duration</div>
                    </div>
                </div>

                <!-- Coverage bars -->
                <div class="coverage-bars">
                    <div class="coverage-row">
                        <div class="coverage-label">Page Coverage</div>
                        <div class="coverage-track">
                            <div class="coverage-fill cyan" style="width: {{ coverage.page.pct }}%;"></div>
                        </div>
                        <div class="coverage-pct">{{ coverage.page.tested }}/{{ coverage.page.total }} ({{ coverage.page.pct }}%)</div>
                    </div>
                    <div class="coverage-row">
                        <div class="coverage-label">Interaction</div>
                        <div class="coverage-track">
                            <div class="coverage-fill blue" style="width: {{ coverage.interaction.pct }}%;"></div>
                        </div>
                        <div class="coverage-pct">{{ coverage.interaction.executed }}/{{ coverage.interaction.total }} ({{ coverage.interaction.pct }}%)</div>
                    </div>
                    <div class="coverage-row">
                        <div class="coverage-label">Pass Rate</div>
                        <div class="coverage-track">
                            <div class="coverage-fill green" style="width: {{ coverage.pass_rate.pct }}%;"></div>
                        </div>
                        <div class="coverage-pct">{{ coverage.pass_rate.passed }}/{{ coverage.pass_rate.total }} ({{ coverage.pass_rate.pct }}%)</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================
             SECTION G: DEFECTS (shown above test suites if failures exist)
             ============================================================ -->
        {% if defects.failures or defects.warnings %}
        <section class="section animate-in delay-2">
            <div class="section-header">
                <h2 style="color: var(--accent-red);">Defects</h2>
                <div class="section-count" style="color: var(--accent-red); border-color: var(--accent-red-dim);">{{ defects.failures|length + defects.warnings|length }}</div>
                <div class="section-line"></div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                {% for flow in defects.failures %}
                <div class="defect-card" onclick="expandTestCase('{{ flow.flow_id }}')">
                    <div class="defect-header">
                        <span class="verdict fail">fail</span>
                        <span class="defect-name">{{ flow.name }}</span>
                    </div>
                    {% if flow.verdict %}
                    <div class="defect-detail">{{ flow.verdict.summary }}</div>
                    {% endif %}
                </div>
                {% endfor %}
                {% for flow in defects.warnings %}
                <div class="defect-card warning" onclick="expandTestCase('{{ flow.flow_id }}')">
                    <div class="defect-header">
                        <span class="verdict warn">warn</span>
                        <span class="defect-name">{{ flow.name }}</span>
                    </div>
                    {% if flow.verdict %}
                    <div class="defect-detail">{{ flow.verdict.summary }}</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        <!-- ============================================================
             SECTION H: DIAGNOSTICS
             ============================================================ -->
        <section class="section section-collapsible collapsed animate-in delay-2">
            <div class="section-header" onclick="toggleSection(this.parentElement)">
                <svg class="section-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                <h2>Exploration Diagnostics</h2>
                <div class="section-count">{{ diagnostics.low_confidence_count }} low-confidence &middot; {{ diagnostics.flaky_paths_count }} flaky</div>
                <div class="section-line"></div>
            </div>
            <div class="section-body">
                <div class="diagnostics-grid">
                    <div class="diag-card">
                        <div class="diag-label">Low-Confidence Steps</div>
                        <div class="diag-value {% if diagnostics.low_confidence_count %}warn{% else %}pass{% endif %}">{{ diagnostics.low_confidence_count }}</div>
                        <div class="diag-subtext">
                            Below {{ "%.0f"|format(diagnostics.low_confidence_threshold * 100) }}% confidence
                            ({{ diagnostics.low_confidence_pct }}% of {{ diagnostics.total_steps }} steps)
                        </div>
                    </div>
                    <div class="diag-card">
                        <div class="diag-label">Flaky Transitions</div>
                        <div class="diag-value {% if diagnostics.flaky_paths_count %}fail{% else %}pass{% endif %}">{{ diagnostics.flaky_paths_count }}</div>
                        <div class="diag-subtext">
                            Same state + action produced multiple outcomes in this run
                        </div>
                    </div>
                    <div class="diag-card">
                        <div class="diag-label">Top Low-Confidence Reasons</div>
                        {% if diagnostics.reason_breakdown %}
                        <div class="diag-reason-list">
                            {% for reason in diagnostics.reason_breakdown %}
                            <span class="diag-chip">{{ reason.reason }} ({{ reason.count }})</span>
                            {% endfor %}
                        </div>
                        {% else %}
                        <div class="diag-value pass">none</div>
                        <div class="diag-subtext">No low-confidence transitions were detected.</div>
                        {% endif %}
                    </div>
                </div>

                {% if diagnostics.low_confidence_items %}
                <div class="data-table-wrap" style="margin-bottom: 1rem;">
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Page</th>
                                    <th>Step</th>
                                    <th>Outcome</th>
                                    <th>Confidence</th>
                                    <th>Reason</th>
                                    <th>Evidence</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in diagnostics.low_confidence_items %}
                                <tr>
                                    <td class="cell-dim">{{ item.step_index }}</td>
                                    <td class="cell-id">{{ item.source_state_short }}</td>
                                    <td class="cell-action">{{ item.action_label }}</td>
                                    <td><span class="outcome {{ item.outcome }}">{{ item.outcome }}</span></td>
                                    <td class="confidence-cell">{{ item.confidence_pct }}%</td>
                                    <td class="cell-dim confidence-reason">{{ item.confidence_reason }}</td>
                                    <td>
                                        {% if item.evidence_link %}
                                        <div class="evidence-cell">
                                            <a class="evidence-thumb-link" href="{{ item.evidence_link }}" target="_blank" rel="noopener noreferrer">
                                                <img class="evidence-thumb" src="{{ item.evidence_link }}" alt="evidence step {{ item.step_index }}" loading="lazy">
                                            </a>
                                            <a class="evidence-open-link" href="{{ item.evidence_link }}" target="_blank" rel="noopener noreferrer">open</a>
                                        </div>
                                        {% else %}
                                        <span class="cell-dim">—</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% endif %}

                {% if diagnostics.flaky_items %}
                <div class="data-table-wrap">
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Page</th>
                                    <th>Step</th>
                                    <th>Outcomes</th>
                                    <th class="right">Occurrences</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in diagnostics.flaky_items %}
                                <tr>
                                    <td class="cell-id">{{ item.source_state_short }}</td>
                                    <td class="cell-action">{{ item.action_label }}</td>
                                    <td class="cell-dim">{{ item.outcomes|join(', ') }}</td>
                                    <td class="cell-right">{{ item.occurrences }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% endif %}
            </div>
        </section>

        <!-- ============================================================
             SECTION C: TEST SUITES (primary view)
             ============================================================ -->
        <section class="section animate-in delay-2">
            <div class="section-header">
                <h2>Test Suites</h2>
                <div class="section-count">{{ flows|length }} cases in {{ flow_groups|length }} suites</div>
                <div class="section-line"></div>
            </div>

            <!-- Filter + search toolbar -->
            <div class="filter-toolbar">
                <button class="filter-btn active" data-filter="all" onclick="filterTestCases('all', this)">All ({{ flows|length }})</button>
                <button class="filter-btn" data-filter="pass" onclick="filterTestCases('pass', this)">Pass ({{ flow_counts.pass }})</button>
                {% if flow_counts.fail %}<button class="filter-btn" data-filter="fail" onclick="filterTestCases('fail', this)">Fail ({{ flow_counts.fail }})</button>{% endif %}
                {% if flow_counts.warn %}<button class="filter-btn" data-filter="warn" onclick="filterTestCases('warn', this)">Warn ({{ flow_counts.warn }})</button>{% endif %}
                <input type="text" class="search-box" placeholder="Search test cases..." oninput="searchTestCases(this.value)">
            </div>

            <!-- Test suites -->
            {% for category, group_flows in flow_groups.items() %}
            {% set gs = group_summaries[category] %}
            <div class="test-suite" data-category="{{ category }}">
                <div class="suite-header" onclick="toggleSuite(this)">
                    <svg class="suite-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                    <span class="suite-name">{{ category }}</span>
                    <div class="suite-meta">
                        {% if gs.pass %}<span class="suite-stat pass">{{ gs.pass }} pass</span>{% endif %}
                        {% if gs.fail %}<span class="suite-stat fail">{{ gs.fail }} fail</span>{% endif %}
                        {% if gs.warn %}<span class="suite-stat warn">{{ gs.warn }} warn</span>{% endif %}
                        <div class="suite-pass-bar">
                            <div class="suite-pass-fill" style="width: {{ group_pass_rates.get(category, 0) }}%;"></div>
                        </div>
                        <div class="section-count">{{ group_flows|length }}</div>
                    </div>
                </div>
                <div class="suite-body">
                    {% for flow in group_flows %}
                    {% set v = flow.verdict.verdict.value if flow.verdict else 'inconclusive' %}
                    <details class="test-case" data-verdict="{{ v }}" data-flow-id="{{ flow.flow_id }}" data-name="{{ flow.name|lower }}">
                        <summary class="test-case-header">
                            <div class="test-case-left">
                                <span class="verdict {{ v }}">{{ v }}</span>
                                <span class="tc-name">{{ flow.name }}</span>
                            </div>
                            <div class="test-case-right">
                                <span class="tc-steps-count">{{ flow.depth }} step{{ 's' if flow.depth != 1 }}</span>
                                {% if flow.tags %}
                                <div class="tc-tags">
                                    {% for tag in flow.tags %}
                                    <span class="tc-tag {{ tag }}">{{ tag }}</span>
                                    {% endfor %}
                                </div>
                                {% endif %}
                                <svg class="tc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                            </div>
                        </summary>
                        <div class="test-case-body">

                            {# --- Precondition --- #}
                            {% if flow.narrative and flow.narrative.precondition %}
                            <div class="precondition">{{ flow.narrative.precondition }}</div>
                            {% endif %}

                            {# --- Step timeline --- #}
                            {% if flow.narrative and flow.narrative.steps %}
                            <div class="step-timeline">
                                {% for step in flow.narrative.steps %}
                                {% set sv = step.verdict.value if step.verdict else '' %}
                                <div class="step-item {{ sv }}">
                                    <div class="step-number">{{ step.step_number }}</div>
                                    <div class="step-content">
                                        <div class="step-action-row">
                                            <span class="step-action-text">{{ step.action_description }}</span>
                                            {% if step.verdict %}<span class="verdict {{ sv }}">{{ sv }}</span>{% endif %}
                                        </div>
                                        <div class="step-details">
                                            {% if step.expected %}<div class="step-expected"><span class="step-tag expected">Expected</span><span class="step-text">{{ step.expected }}</span></div>{% endif %}
                                            {% if step.actual %}<div class="step-actual"><span class="step-tag actual">Actual</span><span class="step-text">{{ step.actual }}</span></div>{% endif %}
                                            {% if step.target_selector %}
                                            <button class="step-selector-toggle" onclick="this.nextElementSibling.classList.toggle('visible')">selector</button>
                                            <div class="step-selector-detail">{{ step.target_selector }}</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                            {% else %}
                            {# Fallback: description for flows without narratives #}
                            <div style="margin-top: 0.75rem; font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.5; word-break: break-all;">{{ flow.description }}</div>
                            {% endif %}

                            {# --- Conclusion --- #}
                            {% if flow.narrative and flow.narrative.conclusion %}
                            <div class="conclusion">{{ flow.narrative.conclusion }}</div>
                            {% endif %}

                            {# --- Action buttons row --- #}
                            <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem; flex-wrap: wrap;">
                                {% if flow.narrative and flow.narrative.gherkin %}
                                <button class="gherkin-toggle" onclick="this.nextElementSibling.classList.toggle('visible')">Gherkin</button>
                                <div class="gherkin-block">{{ flow.narrative.gherkin }}</div>
                                {% endif %}
                                <button class="state-chain-toggle" onclick="toggleStateChain(this)">State Chain</button>
                            </div>

                            {# --- State chain (debug) --- #}
                            <div class="state-chain">
                                {% for sid in flow.state_ids %}
                                <span class="state-node" title="{{ sid }}">{{ states_by_id[sid].title if sid in states_by_id and states_by_id[sid].title else sid[:8] }}</span>
                                {% if not loop.last %}
                                <span class="state-arrow">&rarr;</span>
                                {% endif %}
                                {% endfor %}
                            </div>

                        </div>
                    </details>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </section>

        <!-- ============================================================
             SECTION D: COVERAGE ANALYSIS
             ============================================================ -->
        {% if states|length >= 3 %}
        <section class="section section-collapsible collapsed animate-in delay-3">
            <div class="section-header" onclick="toggleSection(this.parentElement)">
                <svg class="section-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                <h2>Coverage Analysis</h2>
                <div class="section-count">{{ states|length }} pages</div>
                <div class="section-line"></div>
            </div>
            <div class="section-body">
                <div class="coverage-table-wrap">
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Page</th>
                                    <th>URL</th>
                                    <th>Test Cases</th>
                                    <th class="right">Pass</th>
                                    <th class="right">Fail</th>
                                    <th class="right">Warn</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for page in page_coverage_map %}
                                <tr>
                                    <td>{{ page.title }}</td>
                                    <td class="cell-url">{{ page.url }}</td>
                                    <td class="cell-dim">{{ page.test_cases|length }}</td>
                                    <td class="cell-right" style="color: var(--accent-green);">{{ page.pass_count }}</td>
                                    <td class="cell-right" style="color: {% if page.fail_count %}var(--accent-red){% else %}var(--text-muted){% endif %};">{{ page.fail_count }}</td>
                                    <td class="cell-right" style="color: {% if page.warn_count %}var(--accent-amber){% else %}var(--text-muted){% endif %};">{{ page.warn_count }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {% set untested_count = coverage.interaction.total - coverage.interaction.executed %}
                {% if untested_count > 0 %}
                <div class="untested-callout">
                    <span class="callout-icon">&#9888;</span>
                    <span>{{ untested_count }} discovered interaction{{ 's' if untested_count != 1 }} were not exercised during this test run ({{ coverage.interaction.pct }}% interaction coverage).</span>
                </div>
                {% endif %}
            </div>
        </section>
        {% endif %}

        <!-- ============================================================
             SECTION E: EXPLORATION MODEL (graph + pages)
             ============================================================ -->
        <section class="section section-collapsible collapsed animate-in delay-3" id="exploration-model">
            <div class="section-header" onclick="toggleSection(this.parentElement)">
                <svg class="section-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                <h2>Exploration Model</h2>
                <div class="section-count">{{ states|length }} pages &middot; {{ results|length }} actions</div>
                <div class="section-line"></div>
            </div>
            <div class="section-body">
                <div id="graph-container"></div>
                <div class="graph-legend">
                    <div class="legend-item"><div class="legend-dot" style="color: var(--accent-green);"></div> navigation</div>
                    <div class="legend-item"><div class="legend-dot" style="color: var(--accent-amber);"></div> dom change</div>
                    <div class="legend-item"><div class="legend-dot" style="color: var(--accent-red);"></div> error / timeout</div>
                    <div class="legend-item"><div class="legend-dot" style="color: var(--text-muted);"></div> no change</div>
                </div>

                <!-- Pages table -->
                <div class="data-table-wrap" style="margin-top: 1.5rem;">
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>URL</th>
                                    <th class="right">Depth</th>
                                    <th>Signals</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for state in states %}
                                <tr>
                                    <td class="cell-id">{{ state.state_id[:8] }}</td>
                                    <td>{{ state.title or '—' }}</td>
                                    <td class="cell-url">{{ state.url }}</td>
                                    <td class="cell-right">{{ state.depth }}</td>
                                    <td class="cell-signals">{{ state.signals|join(', ') }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <!-- ============================================================
             SECTION F: EXECUTION LOG
             ============================================================ -->
        <section class="section section-collapsible collapsed animate-in delay-4">
            <div class="section-header" onclick="toggleSection(this.parentElement)">
                <svg class="section-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                <h2>Step Execution Log</h2>
                <div class="section-count">{{ results|length }}</div>
                <div class="section-line"></div>
            </div>
            <div class="section-body">
                <div class="data-table-wrap">
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Page</th>
                                    <th>Step</th>
                                    <th>Expected</th>
                                    <th>Outcome</th>
                                    <th>Status</th>
                                    <th>Target</th>
                                    <th>Confidence</th>
                                    <th>Reason</th>
                                    <th>Evidence</th>
                                    <th class="right">Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for r in results %}
                                <tr>
                                    <td class="cell-dim">{{ loop.index }}</td>
                                    <td class="cell-id">{{ r.source_state_id[:8] }}</td>
                                    <td class="cell-action">{{ actions.get(r.action_id, r.action_id) }}</td>
                                    <td class="cell-dim" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ r.expected or '' }}</td>
                                    <td><span class="outcome {{ r.outcome.value }}">{{ r.outcome.value }}</span></td>
                                    <td>{% if r.verdict %}<span class="verdict {{ r.verdict }}">{{ r.verdict }}</span>{% endif %}</td>
                                    <td class="cell-id">{{ r.target_state_id[:8] }}</td>
                                    <td class="confidence-cell">{{ "%.0f"|format((r.confidence or 0) * 100) }}%</td>
                                    <td class="cell-dim confidence-reason">{{ r.confidence_reason or '—' }}</td>
                                    {% set shot = result_screenshot_links[loop.index0] %}
                                    <td>
                                        {% if shot %}
                                        <div class="evidence-cell">
                                            <a class="evidence-thumb-link" href="{{ shot }}" target="_blank" rel="noopener noreferrer">
                                                <img class="evidence-thumb" src="{{ shot }}" alt="evidence step {{ loop.index }}" loading="lazy">
                                            </a>
                                            <a class="evidence-open-link" href="{{ shot }}" target="_blank" rel="noopener noreferrer">open</a>
                                        </div>
                                        {% else %}
                                        <span class="cell-dim">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="cell-right">{{ "%.0f"|format(r.duration_ms) }}ms</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="report-container">
        <div class="report-footer">
            generated by <span>flowscout</span> v{{ version }}
        </div>
    </footer>

    <!-- ============================================================
         VIS.JS (deferred — loaded but graph not initialized until section expands)
         ============================================================ -->
    <script>{{ vis_network_js }}</script>

    <!-- ============================================================
         SCRIPTS
         ============================================================ -->
    <script>
        /* --- Graph data (used by lazy init) --- */
        const graphData = {{ graph_json }};
        let graphInitialized = false;

        /* --- Lazy graph init on first expand of Exploration Model section --- */
        function initGraph() {
            if (graphInitialized) return;
            graphInitialized = true;

            const depthPalette = ['#00e59b', '#4facfe', '#00f5d4', '#ffbe0b', '#ff6b6b', '#c084fc'];
            const outcomeEdgeColors = {
                'navigation': '#00e59b',
                'dom_change': '#ffbe0b',
                'visual_change': '#4facfe',
                'no_change': '#4a5f78',
                'validation_error': '#ff4757',
                'network_error': '#ff4757',
                'console_error': '#ff4757',
                'timeout': '#ff6b6b',
                'exception': '#ff4757',
            };

            const nodes = new vis.DataSet(graphData.nodes.map(n => ({
                id: n.id,
                label: (n.label || n.url || n.id).substring(0, 35),
                title: '<div style="font-family:monospace;font-size:11px;padding:6px 10px;line-height:1.6;max-width:320px;">' +
                       '<strong style="color:' + depthPalette[Math.min(n.depth, depthPalette.length-1)] + '">' + n.id.substring(0,8) + '</strong><br>' +
                       'URL: ' + n.url + '<br>Depth: ' + n.depth + '<br>' +
                       'Signals: ' + (n.signals||[]).join(', ') + '</div>',
                color: {
                    background: '#0f1620',
                    border: depthPalette[Math.min(n.depth, depthPalette.length - 1)],
                    highlight: { background: '#1a2636', border: '#00e59b' },
                    hover: { background: '#141e2b', border: depthPalette[Math.min(n.depth, depthPalette.length - 1)] },
                },
                font: {
                    color: '#c8d6e5',
                    size: 11,
                    face: "'JetBrains Mono', monospace",
                },
                shape: 'box',
                borderWidth: 2,
                borderWidthSelected: 3,
                margin: { top: 10, right: 14, bottom: 10, left: 14 },
                shadow: {
                    enabled: true,
                    color: depthPalette[Math.min(n.depth, depthPalette.length - 1)] + '15',
                    size: 20,
                    x: 0,
                    y: 4,
                },
            })));

            const edges = new vis.DataSet(graphData.edges.map((e, i) => ({
                id: i,
                from: e.source,
                to: e.target,
                label: (e.label || '').replace(/^Click:\s*/, '').substring(0, 22),
                title: '<div style="font-family:monospace;font-size:11px;padding:6px 10px;">' +
                       'Action: ' + e.label + '<br>Outcome: <strong>' + e.outcome + '</strong></div>',
                color: {
                    color: outcomeEdgeColors[e.outcome] || '#4a5f78',
                    highlight: '#00e59b',
                    hover: outcomeEdgeColors[e.outcome] || '#7a8fa6',
                    opacity: 0.7,
                },
                arrows: { to: { enabled: true, scaleFactor: 0.6, type: 'arrow' } },
                font: {
                    color: '#7a8fa6',
                    size: 9,
                    strokeWidth: 0,
                    face: "'JetBrains Mono', monospace",
                    align: 'top',
                },
                smooth: { type: 'curvedCW', roundness: 0.15 },
                width: 1.5,
                hoverWidth: 0.5,
            })));

            const container = document.getElementById('graph-container');
            const network = new vis.Network(container, { nodes, edges }, {
                physics: {
                    solver: 'forceAtlas2Based',
                    forceAtlas2Based: {
                        gravitationalConstant: -50,
                        centralGravity: 0.008,
                        springLength: 180,
                        springConstant: 0.04,
                        damping: 0.4,
                        avoidOverlap: 0.5,
                    },
                    stabilization: { iterations: 200, fit: true },
                },
                interaction: {
                    hover: true,
                    tooltipDelay: 150,
                    zoomView: true,
                    dragView: true,
                },
                layout: { improvedLayout: true },
            });

            network.once('stabilizationIterationsDone', () => {
                network.fit({ animation: { duration: 400, easingFunction: 'easeInOutQuad' } });
            });
        }

        /* --- Toggle collapsible section --- */
        function toggleSection(sectionEl) {
            sectionEl.classList.toggle('collapsed');
            /* Lazy-init graph when Exploration Model is first expanded */
            if (sectionEl.id === 'exploration-model' && !sectionEl.classList.contains('collapsed')) {
                initGraph();
            }
        }

        /* --- Toggle test suite --- */
        function toggleSuite(headerEl) {
            headerEl.parentElement.classList.toggle('collapsed');
        }

        /* --- Filter test cases by verdict --- */
        function filterTestCases(verdict, btnEl) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active', 'active-fail', 'active-warn'));
            if (btnEl) {
                if (verdict === 'fail') btnEl.classList.add('active-fail');
                else if (verdict === 'warn') btnEl.classList.add('active-warn');
                else btnEl.classList.add('active');
            }

            document.querySelectorAll('.test-case').forEach(card => {
                card.style.display = (verdict === 'all' || card.dataset.verdict === verdict) ? '' : 'none';
            });

            /* Hide empty suites */
            document.querySelectorAll('.test-suite').forEach(suite => {
                const visible = suite.querySelectorAll('.test-case:not([style*="display: none"])');
                suite.style.display = visible.length > 0 ? '' : 'none';
            });
        }

        /* --- Search test cases --- */
        function searchTestCases(query) {
            const q = query.toLowerCase().trim();
            document.querySelectorAll('.test-case').forEach(card => {
                if (!q) {
                    card.style.display = '';
                } else {
                    card.style.display = card.dataset.name.includes(q) ? '' : 'none';
                }
            });
            /* Hide empty suites */
            document.querySelectorAll('.test-suite').forEach(suite => {
                const visible = suite.querySelectorAll('.test-case:not([style*="display: none"])');
                suite.style.display = visible.length > 0 ? '' : 'none';
            });
        }

        /* --- Toggle state chain visibility --- */
        function toggleStateChain(btn) {
            const chain = btn.closest('.test-case-body').querySelector('.state-chain');
            if (chain) chain.classList.toggle('visible');
        }

        /* --- Expand specific test case from defects section --- */
        function expandTestCase(flowId) {
            const el = document.querySelector('.test-case[data-flow-id="' + flowId + '"]');
            if (!el) return;
            /* Ensure parent suite is not collapsed */
            const suite = el.closest('.test-suite');
            if (suite && suite.classList.contains('collapsed')) {
                suite.classList.remove('collapsed');
            }
            el.open = true;
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    </script>

</body>
</html>
